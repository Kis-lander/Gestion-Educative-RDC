    <script>
      document.getElementById("attachmentInput")?.addEventListener("change", function(e) {
        const file = e.target.files?.[0];
        if (!file) return;

        const label = window.AppTranslations?.translate("Fichier joint") || "Fichier joint";
        document.getElementById("fileName").textContent = `${label}: ${file.name}`;
        document.getElementById("fileName").classList.remove("hidden");
      });
    </script>
  @endsection
