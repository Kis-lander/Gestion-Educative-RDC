        <div class="bg-blue-50 dark:bg-blue-900/20 rounded-xl p-4">
          <h3 class="font-semibold mb-2" data-i18n>Avant d'envoyer</h3>
          <ul class="text-sm space-y-2 text-gray-600 dark:text-gray-300">
            <li><i class="fas fa-check text-primary mr-2"></i><span data-i18n>Vérifiez les filtres de classe, trimestre, section ou année scolaire.</span></li>
