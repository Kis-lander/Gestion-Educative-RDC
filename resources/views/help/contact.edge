        <form method="POST" action="/help/contact" enctype="multipart/form-data" x-data="{ loading: false }" @submit="loading = true">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-gray-700 dark:text-gray-300 mb-2" data-i18n>Sujet *</label>
              <select name="subject" required class="w-full px-3 py-2 border rounded-lg">
                <option value="" data-i18n>Sélectionner un sujet</option>
                <option value="access" data-i18n>Accès ou rôle</option>
                <option value="academic" data-i18n>Scolarité, notes ou présences</option>
                <option value="finance" data-i18n>Paiement ou finances</option>
                <option value="discipline" data-i18n>Discipline ou sanction</option>
                <option value="transfer" data-i18n>Transfert d'élève</option>
                <option value="communication" data-i18n>Messages ou notifications</option>
                <option value="technical" data-i18n>Problème technique</option>
                <option value="feature" data-i18n>Demande d'amélioration</option>
              </select>
            </div>
            <div>
              <label class="block text-gray-700 dark:text-gray-300 mb-2" data-i18n>Module concerné</label>
              <input name="module" class="w-full px-3 py-2 border rounded-lg" placeholder="Exemple : Notes, Paiements, Transferts" />
            </div>
          </div>

          <div class="mt-4">
            <label class="block text-gray-700 dark:text-gray-300 mb-2" data-i18n>Votre message *</label>
            <textarea
              name="message"
              required
              rows="7"
              class="w-full px-3 py-2 border rounded-lg"
              placeholder="Indiquez votre rôle, l'action tentée, le message d'erreur éventuel et le résultat attendu."
            ></textarea>
          </div>

          <div class="mt-4">
            <label class="block text-gray-700 dark:text-gray-300 mb-2" data-i18n>Pièce jointe utile</label>
            <div class="border-2 border-dashed rounded-lg p-4 text-center cursor-pointer hover:border-primary transition" onclick="document.getElementById('attachmentInput').click()">
              <input type="file" name="attachment" id="attachmentInput" class="hidden" accept=".pdf,.jpg,.jpeg,.png,.zip,.doc,.docx" />
              <i class="fas fa-cloud-upload-alt text-3xl text-gray-400 mb-2"></i>
              <p class="text-gray-500" data-i18n>Ajouter une capture, un reçu ou un document</p>
              <p class="text-xs text-gray-400 mt-1" data-i18n>PDF, image, document ou ZIP</p>
            </div>
            <div id="fileName" class="text-sm text-green-600 mt-2 hidden"></div>
          </div>

          <div class="flex gap-3 mt-6 pt-4 border-t dark:border-gray-700">
            <button type="submit" :disabled="loading" class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-blue-700 disabled:opacity-70">
              <i x-show="loading" class="fas fa-spinner fa-spin mr-2"></i>
              <span data-i18n>Envoyer la demande</span>
            </button>
          </div>
        </form>
