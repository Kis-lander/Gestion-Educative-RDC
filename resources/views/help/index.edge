    <div id="emptySearch" class="hidden bg-amber-50 dark:bg-amber-900/20 rounded-xl p-5 text-sm text-gray-700 dark:text-gray-200" data-i18n>
      Aucun contenu ne correspond à votre recherche. Essayez avec un module comme notes, paiements, transferts, messages ou rapports.
    </div>

    <script>
      const helpSearch = document.getElementById("searchHelp");
      const searchableItems = Array.from(document.querySelectorAll(".help-card, .help-article"));
      const emptySearch = document.getElementById("emptySearch");

      helpSearch?.addEventListener("input", () => {
        const query = helpSearch.value.trim().toLowerCase();
        let visible = 0;

        searchableItems.forEach(item => {
          const text = `${item.textContent} ${item.dataset.search || ""}`.toLowerCase();
          const matches = !query || text.includes(query);
          item.classList.toggle("hidden", !matches);
          if (matches) visible += 1;
        });

        emptySearch.classList.toggle("hidden", visible > 0);
      });

      document.querySelectorAll("[data-help-view-slug]").forEach(link => {
        link.addEventListener("click", () => {
          const slug = link.dataset.helpViewSlug;
          if (!slug) return;

          fetch("/api/help/views", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-CSRF-TOKEN": "{{ csrfToken }}"
            },
            body: JSON.stringify({ slug }),
            keepalive: true
          }).catch(() => {});
        });
      });
    </script>
