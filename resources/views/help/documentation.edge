        <div
          class="pt-5 border-t dark:border-gray-700"
          x-data="{ showRemark: false, remark: '', sending: false, message: '', error: '' }"
        >
          <p class="text-sm text-gray-500" data-i18n>
            Cette documentation vous a-t-elle été utile ?
          </p>
          <div class="flex gap-2 mt-2">
            <button
              type="button"
              @click="showRemark = false; feedback(true)"
              class="px-3 py-1 border rounded-lg text-sm hover:bg-green-50"
              data-i18n
            >Oui</button>
            <button
              type="button"
              @click="showRemark = true; message = ''; error = ''; $nextTick(() => $refs.remark?.focus())"
              class="px-3 py-1 border rounded-lg text-sm hover:bg-red-50"
              data-i18n
            >Non</button>
          </div>

          <form
            x-show="showRemark"
            x-cloak
            class="mt-4 rounded-lg border dark:border-gray-700 p-4"
            @submit.prevent="feedback(false, remark, { setSending: value => sending = value, setMessage: value => message = value, setError: value => error = value, close: () => showRemark = false })"
          >
            <label
              for="documentationRemark"
              class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2"
              data-i18n
            >
              Quelle remarque souhaitez-vous transmettre à l'inspection ?
            </label>
            <textarea
              id="documentationRemark"
              x-ref="remark"
              x-model="remark"
              rows="4"
              required
              minlength="3"
              maxlength="2000"
              class="w-full px-3 py-2 border rounded-lg"
              placeholder="Expliquez ce qui manque, ce qui est incorrect ou ce qui devrait être amélioré."
            ></textarea>
            <div class="flex items-center gap-3 mt-3">
              <button
                type="submit"
                :disabled="sending"
                class="px-4 py-2 bg-primary text-white rounded-lg text-sm hover:bg-blue-700 disabled:opacity-70"
              >
                <i x-show="sending" class="fas fa-spinner fa-spin mr-2"></i>
                <span data-i18n>Envoyer la remarque</span>
              </button>
              <button
                type="button"
                @click="showRemark = false; remark = ''; error = ''; message = ''"
                class="px-4 py-2 border rounded-lg text-sm hover:bg-gray-50"
                data-i18n
              >
                Annuler
              </button>
            </div>
            <p x-show="message" class="mt-3 text-sm text-green-600" x-text="message">
            </p>
            <p x-show="error" class="mt-3 text-sm text-red-600" x-text="error">
            </p>
          </form>
        </div>
      </div>
    </div>

    <script>
      function feedback(helpful, remark = "", ui = null) {
        ui?.setSending?.(true);
        ui?.setError?.("");
        ui?.setMessage?.("");
        fetch("/api/help/documentation/feedback", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-TOKEN": "{{ csrfToken }}"
          },
          body: JSON.stringify({
            helpful: helpful,
            remark: remark,
            page: "documentation"
          })
        }).then(async response => {
          const data = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(data.message || "Impossible d'enregistrer votre retour.");
          const successMessage = window.AppTranslations?.translate("Merci pour votre retour !") || "Merci pour votre retour !";
          if (ui) {
            ui.setMessage(successMessage);
            ui.close?.();
          } else {
            alert(successMessage);
          }
        }).catch(error => {
          const message = window.AppTranslations?.translate(error.message) || error.message;
          if (ui) {
            ui.setError(message);
          } else {
            alert(message);
          }
        }).finally(() => ui?.setSending?.(false));
      }

      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener("click", function(e) {
          e.preventDefault();
          const targetSelector = this.getAttribute("href");
          const target = document.querySelector(targetSelector);
          if (!target) return;
          target.scrollIntoView({
            behavior: "smooth",
            block: "start"
          });
          history.replaceState(null, "", targetSelector);
        });
      });
    </script>
  @endsection
