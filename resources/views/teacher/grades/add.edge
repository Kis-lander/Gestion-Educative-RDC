    Saisie de notes
  @endsection
  @section('dashboardSubtitle')
    Ajoutez des notes pour vos élèves
  @endsection
  
  @section('content')
    <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6">
      <!-- Sélection -->
      <div class="grid grid-cols-1 md:grid-cols-6 gap-4 mb-6">
        <div>
          <label class="block text-gray-700 dark:text-gray-300 mb-2">Classe *</label>
          <select id="classSelect" class="w-full px-3 py-2 border rounded-lg">
            <option value="">
              Sélectionner
            </option>
            @each(classObj in myClasses)
              <option value="{{ classObj.id }}" {{ selectedClassId === classObj.id ? 'selected' : '' }}>
                {{ classObj.name }}
              </option>
            @end
          </select>
        </div>
        <div>
          <label class="block text-gray-700 dark:text-gray-300 mb-2">Matière *</label>
          <select id="subjectSelect" class="w-full px-3 py-2 border rounded-lg" disabled>
            <option value="">
              Sélectionnez d'abord une classe
            </option>
          </select>
        </div>
        <div>
          <label id="termLabel" class="block text-gray-700 dark:text-gray-300 mb-2" data-i18n>Période scolaire *</label>
          <select id="termSelect" class="w-full px-3 py-2 border rounded-lg">
          </select>
        </div>
        <div>
          <label class="block text-gray-700 dark:text-gray-300 mb-2" data-i18n>Type d'évaluation *</label>
          <select id="examTypeSelect" class="w-full px-3 py-2 border rounded-lg">
          </select>
        </div>
        <div>
          <label class="block text-gray-700 dark:text-gray-300 mb-2" data-i18n>Date de l'évaluation *</label>
          <input type="date" id="examDate" class="w-full px-3 py-2 border rounded-lg" />
        </div>
        <div>
          <label class="block text-gray-700 dark:text-gray-300 mb-2" data-i18n>Pondération *</label>
          <input type="number" id="maxScoreInput" min="1" max="500" step="0.5" value="20" class="w-full px-3 py-2 border rounded-lg" />
        </div>
      </div>

      <!-- Grille des notes -->
      <div id="gradesGrid" class="mt-4">
        <div class="text-center py-8 text-gray-500">
          <i class="fas fa-arrow-left text-2xl mb-2 block"></i>
          Sélectionnez une classe et une matière pour commencer
        </div>
      </div>

      <!-- Actions -->
      <div class="flex gap-3 mt-6 pt-4 border-t" id="actionButtons" style="display: none;">
        <button id="saveGrades" class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-blue-700">
          <i class="fas fa-save mr-2"></i>Enregistrer les notes
    </button>
        <button id="saveAndPublish" class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700">
          <i class="fas fa-check-circle mr-2"></i>Enregistrer et publier
    </button>
      </div>
    </div>

    <script>
      const classSelect = document.getElementById("classSelect");

      const subjectSelect = document.getElementById("subjectSelect");

      const termSelect = document.getElementById("termSelect");

      const examTypeSelect = document.getElementById("examTypeSelect");

      const examDate = document.getElementById("examDate");
      const maxScoreInput = document.getElementById("maxScoreInput");

      const gradesGrid = document.getElementById("gradesGrid");

      const actionButtons = document.getElementById("actionButtons");

      let studentsList = [];

      let existingGrades = {};

      let subjectId = null;
      const evaluationPolicies = {{ evaluationPolicies|json_encode|raw }};
      const classEvaluationPolicies = {{ classEvaluationPolicies|json_encode|raw }};
      const fallbackTermOptions = {{ fallbackTermOptions|json_encode|raw }};
      const fallbackEvaluationTypeOptions = {{ fallbackEvaluationTypeOptions|json_encode|raw }};
      const translate = (text) => window.AppTranslations?.translate(text) || text;

      function selectedPolicy() {
        return classEvaluationPolicies[classSelect.value] || Object.values(classEvaluationPolicies)[0] || {
          periods: fallbackTermOptions,
          evaluationTypes: fallbackEvaluationTypeOptions,
          periodAxisLabel: "Période scolaire"
        };
      }

      selectedPolicy = function() {
        return classEvaluationPolicies[classSelect.value] ||
          evaluationPolicies.secondaire ||
          evaluationPolicies.primaire ||
          Object.values(classEvaluationPolicies)[0] ||
          Object.values(evaluationPolicies)[0] || {
            periods: [
              { value: "S1-P1", label: "Semestre 1 - P\u00e9riode 1" },
              { value: "S1-P2", label: "Semestre 1 - P\u00e9riode 2" },
              { value: "S1-EX", label: "Semestre 1 - Examen semestriel" },
              { value: "S2-P1", label: "Semestre 2 - P\u00e9riode 1" },
              { value: "S2-P2", label: "Semestre 2 - P\u00e9riode 2" },
              { value: "S2-EX", label: "Semestre 2 - Examen semestriel" }
            ],
            evaluationTypes: [
              { value: "Travail journalier", label: "Travail journalier" },
              { value: "Interrogation", label: "Interrogation" },
              { value: "Devoir", label: "Devoir" },
              { value: "Examen semestriel", label: "Examen semestriel" }
            ],
            periodAxisLabel: "P\u00e9riode scolaire"
          };
      };

      function choiceValue(choice) {
        return Array.isArray(choice) ? choice[0] : choice.value;
      }

      function choiceLabel(choice) {
        return Array.isArray(choice) ? choice[1] : choice.label;
      }
      function renderEvaluationPolicy() {
        const policy = selectedPolicy();
        document.getElementById("termLabel").textContent = `${translate("Période scolaire")} *`;
        const periods = policy.periods?.length ? policy.periods : fallbackTermOptions;
        const evaluationTypes = policy.evaluationTypes?.length ? policy.evaluationTypes : fallbackEvaluationTypeOptions;
        termSelect.innerHTML = periods
          .map((period) => `<option value="${choiceValue(period)}">${translate(choiceLabel(period))}</option>`)
          .join("");
        examTypeSelect.innerHTML = evaluationTypes
          .map((type) => `<option value="${choiceValue(type)}">${translate(choiceLabel(type))}</option>`)
          .join("");
      }
      renderEvaluationPolicy();
      // Charger les matières

      classSelect.addEventListener("change", async () => {
        renderEvaluationPolicy();
        const classId = classSelect.value;
        if (!classId) return;
        const res = await fetch(`/api/teacher/classes/${classId}/my-subjects`);
        const data = await res.json();
        subjectSelect.innerHTML = '<option value="">Sélectionner une matière</option>';
        if (data.subjects && data.subjects.length > 0) {
          data.subjects.forEach(subject => {
            subjectSelect.innerHTML += `<option value="${subject.id}">${subject.name}</option>`;
          });
          subjectSelect.disabled = false;
        } else {
          subjectSelect.innerHTML = '<option value="">Aucune matière assignée</option>';
          subjectSelect.disabled = true;
        }
      });
      if (classSelect.value) {
        classSelect.dispatchEvent(new Event("change"));
      }

      // Charger les élèves

      subjectSelect.addEventListener("change", async () => {
        const classId = classSelect.value;
        subjectId = subjectSelect.value;
        const term = termSelect.value;
        const examType = encodeURIComponent(examTypeSelect.value);
        if (!classId || !subjectId) return;
        // Charger les élèves
        const studentsRes = await fetch(`/api/teacher/classes/${classId}/students`);
        const studentsData = await studentsRes.json();
        studentsList = studentsData.students || [];
        // Charger les notes existantes
        const gradesRes = await fetch(`/api/teacher/grades/class/${classId}?subject_id=${subjectId}&term=${term}&exam_type=${examType}`);
        const gradesData = await gradesRes.json();
        existingGrades = {};
        if (gradesData.gradesByStudent) {
          gradesData.gradesByStudent.forEach(student => {
            student.grades.forEach(grade => {
              existingGrades[grade.studentId] = grade;
            });
          });
        }
        renderGradesForm();
        actionButtons.style.display = "flex";
      });

      function renderGradesForm() {
        const maxScore = Number(maxScoreInput.value) || 20;
        if (!studentsList.length) {
          gradesGrid.innerHTML = `<div class="text-center py-8 text-gray-500">${translate("Aucun élève dans cette classe")}</div>`;
          return;
        }
        let html = `
                <div class="table-responsive">
                  <table class="w-full">
                    <thead class="bg-gray-50 dark:bg-gray-700">
                      <tr>
                        <th class="px-4 py-3 text-left">${translate("Matricule")}</th>
                        <th class="px-4 py-3 text-left">${translate("Élève")}</th>
                        <th class="px-4 py-3 text-center">${translate("Note")} /${maxScore}</th>
                        <th class="px-4 py-3 text-left">${translate("Appréciation")}</th>
                      </tr>
                    </thead>
                    <tbody>
              `;
        studentsList.forEach(student => {
          const existingGrade = existingGrades[student.id];
          const noteValue = existingGrade ? existingGrade.score : "";
          const commentValue = existingGrade ? existingGrade.teacherComments || "" : "";
          html += `
                  <tr class="border-b dark:border-gray-700">
                    <td class="px-4 py-3 font-mono text-sm">${student.registrationNumber}</td>
                    <td class="px-4 py-3 font-medium">${student.name}</td>
                    <td class="px-4 py-3 text-center">
                      <input type="number" step="0.5" min="0" max="${maxScore}" 
                             class="grade-input w-24 px-2 py-1 border rounded text-center"
                             data-student-id="${student.id}"
                             value="${noteValue}"
                             placeholder="0-${maxScore}">
                    </td>
                    <td class="px-4 py-3">
                      <input type="text" class="comment-input w-full px-2 py-1 border rounded text-sm"
                             data-student-id="${student.id}"
                             value="${escapeHtml(commentValue)}"
                             placeholder="${translate("Appréciation (optionnel)")}">
                    </td>
                  </tr>
                `;
        });
        html += `
                    </tbody>
                  </table>
                </div>
              `;
        gradesGrid.innerHTML = html;
      }

      function escapeHtml(text) {
        const div = document.createElement("div");
        div.textContent = text;
        return div.innerHTML;
      }

      async function saveGrades(publish = false) {
        const classId = classSelect.value;
        const term = termSelect.value;
        const examType = examTypeSelect.value;
        const date = examDate.value;
        const maxScore = Number(maxScoreInput.value);
        if (!classId || !subjectId) {
          alert(translate("Veuillez sélectionner une classe et une matière."));
          return;
        }
        if (!date) {
          alert(translate("Veuillez sélectionner une date d'évaluation."));
          return;
        }
        if (!Number.isFinite(maxScore) || maxScore <= 0 || maxScore > 500) {
          alert(translate("Veuillez saisir une pondération entre 1 et 500."));
          return;
        }
        const grades = [];
        document.querySelectorAll(".grade-input").forEach(input => {
          const studentId = input.dataset.studentId;
          const score = parseFloat(input.value);
          const comment = document.querySelector(`.comment-input[data-student-id="${studentId}"]`)?.value || "";
          if (!isNaN(score) && score >= 0 && score <= maxScore) {
            grades.push({
              studentId: studentId,
              score: score,
              comment: comment
            });
          }
        });
        if (grades.length === 0) {
          alert(translate("Aucune note valide à enregistrer."));
          return;
        }
        // Afficher loading
        const loading = document.createElement("div");
        loading.className = "fixed inset-0 bg-black/50 flex items-center justify-center z-50";
        loading.innerHTML = '<div class="spinner"></div>';
        document.body.appendChild(loading);
        let successCount = 0;
        for (const grade of grades) {
          const res = await fetch("/teacher/grades", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-CSRF-TOKEN": "{{ csrfToken }}"
            },
            body: JSON.stringify({
              studentId: grade.studentId,
              subjectId: subjectId,
              classId: classId,
              term: term,
              examType: examType,
              score: grade.score,
              maxScore: maxScore,
              teacherComments: grade.comment,
              examDate: date
            })
          });
          const data = await res.json();
          if (data.success) successCount++;
        }
        if (publish) {
          await fetch("/api/teacher/grades/publish", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-CSRF-TOKEN": "{{ csrfToken }}"
            },
            body: JSON.stringify({
              classId: classId,
              subjectId: subjectId,
              term: term
            })
          });
          alert(`${successCount} note(s) enregistrée(s) et publiée(s) avec succès`);
        } else {
          alert(`${successCount} note(s) enregistrée(s) avec succès`);
        }
        loading.remove();
        // Recharger
        const res = await fetch(`/api/teacher/grades/class/${classId}?subject_id=${subjectId}&term=${term}&exam_type=${encodeURIComponent(examType)}`);
        const data = await res.json();
        existingGrades = {};
        if (data.gradesByStudent) {
          data.gradesByStudent.forEach(student => {
            student.grades.forEach(grade => {
              existingGrades[grade.studentId] = grade;
            });
          });
        }
        renderGradesForm();
      }

      examTypeSelect.addEventListener("change", () => {
        if (subjectId) subjectSelect.dispatchEvent(new Event("change"));
        else renderGradesForm();
      });
      maxScoreInput.addEventListener("change", renderGradesForm);
      document.getElementById("saveGrades")?.addEventListener("click", () => saveGrades(false));

      document.getElementById("saveAndPublish")?.addEventListener("click", () => saveGrades(true));
      // Date par défaut

      examDate.value = new Date().toISOString().split("T")[0];
    </script>

    <style>
      .spinner {
        border: 3px solid #f3f4f6;
        border-top: 3px solid #2563eb;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
        background: white;
      }
      
      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
      
        100% {
          transform: rotate(360deg);
        }
      }
    </style>
  @endsection
  
