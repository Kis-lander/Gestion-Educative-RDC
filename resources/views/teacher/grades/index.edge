    </div>

    <script>
      const filterClass = document.getElementById("filterClass");

      const filterSubject = document.getElementById("filterSubject");

      const filterTerm = document.getElementById("filterTerm");
      const classEvaluationPolicies = {{ classEvaluationPolicies|json_encode|raw }};
      const allTermOptions = {{ filterTermOptions|json_encode|raw }};
      const fallbackTermOptions = {{ fallbackTermOptions|json_encode|raw }};
      const selectedTerm = new URLSearchParams(window.location.search).get("term") || "";

      const filterStatus = document.getElementById("filterStatus");

      const applyBtn = document.getElementById("applyFilters");

      const resetBtn = document.getElementById("resetFilters");

      function renderTermOptions() {
        const policy = classEvaluationPolicies[filterClass.value];
        const terms = policy?.periods?.length
          ? policy.periods
          : (allTermOptions.length ? allTermOptions : fallbackTermOptions);
        filterTerm.innerHTML = `<option value="">${window.AppTranslations?.translate("Tous") || "Tous"}</option>`;
        terms.forEach((term) => {
          const option = document.createElement("option");
          option.value = term.value;
          option.textContent = window.AppTranslations?.translate(term.label) || term.label;
          filterTerm.appendChild(option);
        });
        filterTerm.value = selectedTerm;
      }

      filterClass.addEventListener("change", renderTermOptions);
      renderTermOptions();

      applyBtn.addEventListener("click", () => {
        const params = new URLSearchParams();
        if (filterClass.value) params.set("class_id", filterClass.value);
        if (filterSubject.value) params.set("subject_id", filterSubject.value);
        if (filterTerm.value) params.set("term", filterTerm.value);
        if (filterStatus.value) params.set("published", filterStatus.value === "published");
        window.location.href = `/teacher/grades?${params.toString()}`;
      });

      resetBtn.addEventListener("click", () => {
        window.location.href = "/teacher/grades";
      });

      function deleteGrade(gradeId) {
        if (confirm("Supprimer cette note ? Cette action est irréversible.")) {
          fetch(`/teacher/grades/${gradeId}`, {
            method: "DELETE",
            headers: {
              "X-CSRF-TOKEN": "{{ csrfToken }}"
            }
          }).then(res => res.json()).then(data => {
            if (data.success) location.reload(); else alert("Erreur: " + data.message);
          });
        }
      }

      function exportGrades() {
        const params = new URLSearchParams();
        if (filterClass.value) params.set("class_id", filterClass.value);
        if (filterSubject.value) params.set("subject_id", filterSubject.value);
        if (filterTerm.value) params.set("term", filterTerm.value);
        window.location.href = `/api/teacher/grades/export?${params.toString()}`;
      }
    </script>
  @endsection
  
