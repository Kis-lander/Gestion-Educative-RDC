    <script>
      const classEvaluationPolicies = {{ classEvaluationPolicies|json_encode|raw }};
      const evaluationPolicies = {{ evaluationPolicies|json_encode|raw }};
      const fallbackTermOptions = {{ fallbackTermOptions|json_encode|raw }};
      const allTermOptions = {{ termOptions|json_encode|raw }};
      const defaultSecondaryTerms = [
        { value: "S1-P1", label: "Semestre 1 - Période 1" },
        { value: "S1-P2", label: "Semestre 1 - Période 2" },
        { value: "S1-EX", label: "Semestre 1 - Examen semestriel" },
        { value: "S2-P1", label: "Semestre 2 - Période 1" },
        { value: "S2-P2", label: "Semestre 2 - Période 2" },
        { value: "S2-EX", label: "Semestre 2 - Examen semestriel" }
      ];

      function choiceValue(choice) {
        return Array.isArray(choice) ? choice[0] : choice.value;
      }

      function choiceLabel(choice) {
        return Array.isArray(choice) ? choice[1] : choice.label;
      }

      function escapeHtml(value) {
        return String(value || "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;");
      }

      function populateTerms(classId) {
        const termSelect = document.getElementById("termSelect");
        const policy = classEvaluationPolicies[classId];
        const firstPolicy = Object.values(classEvaluationPolicies)[0];
        const periods = policy?.periods?.length
          ? policy.periods
          : (
              firstPolicy?.periods?.length
                ? firstPolicy.periods
                : (
                    allTermOptions.length
                      ? allTermOptions
                      : (
                          fallbackTermOptions.length
                            ? fallbackTermOptions
                            : (evaluationPolicies.secondaire?.periods || defaultSecondaryTerms)
                        )
                  )
            );

        if (!periods.length) {
          termSelect.innerHTML = defaultSecondaryTerms
            .map((period) => `<option value="${period.value}">${period.label}</option>`)
            .join("");
          termSelect.disabled = false;
          return;
        }

        termSelect.innerHTML = periods
          .map((period) => `<option value="${escapeHtml(choiceValue(period))}">${escapeHtml(choiceLabel(period))}</option>`)
          .join("");
        termSelect.disabled = false;
      }
      // Charger les matières selon la classe
      document.getElementById("classSelect")?.addEventListener("change", async function() {
        const classId = this.value;
        const subjectSelect = document.getElementById("subjectSelect");
        populateTerms(classId);
        if (!classId) {
          subjectSelect.innerHTML = '<option value="">Sélectionnez d\'abord une classe</option>';
          subjectSelect.disabled = true;
          return;
        }
        const res = await fetch(`/api/classes/${classId}/subjects`);
        const data = await res.json();
        subjectSelect.innerHTML = '<option value="">Sélectionner une matière</option>';
        if (data.subjects && data.subjects.length > 0) {
          data.subjects.forEach(subject => {
            subjectSelect.innerHTML += `<option value="${subject.subject_id}">${subject.subject_name} (${subject.hours_per_week}h/sem)</option>`;
          });
          subjectSelect.disabled = false;
        } else {
          subjectSelect.innerHTML = '<option value="">Aucune matière assignée</option>';
          subjectSelect.disabled = true;
        }
      });
      function refreshTermsFromSelectedClass() {
        const classSelect = document.getElementById("classSelect");
        populateTerms(classSelect?.value || Object.keys(classEvaluationPolicies)[0] || "");
      }

      refreshTermsFromSelectedClass();
      window.addEventListener("pageshow", refreshTermsFromSelectedClass);
      document.addEventListener("DOMContentLoaded", refreshTermsFromSelectedClass);
      setTimeout(refreshTermsFromSelectedClass, 100);
      setTimeout(refreshTermsFromSelectedClass, 500);
      document.getElementById("termSelect")?.addEventListener("focus", refreshTermsFromSelectedClass);
      document.getElementById("termSelect")?.addEventListener("mousedown", refreshTermsFromSelectedClass);
      // Gestion du fichier

      const fileInput = document.getElementById("fileInput");

      const fileName = document.getElementById("fileName");

      fileInput?.addEventListener("change", function() {
        if (this.files && this.files[0]) {
          fileName.textContent = `Fichier sélectionné: ${this.files[0].name}`;
          fileName.classList.remove("hidden");
        }
      });
      // Date par défaut (2 semaines)

      const dueDate = new Date();

      dueDate.setDate(dueDate.getDate() + 14);

      document.querySelector('input[name="dueDate"]').value = dueDate.toISOString().split("T")[0];
    </script>
  @endsection
  
