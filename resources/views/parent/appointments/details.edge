    <script>
      function cancelAppointment(appointmentId) {
        if (confirm("Annuler ce rendez-vous ?")) {
          fetch(`/api/parent/appointments/${appointmentId}/cancel`, {
            method: "DELETE",
            headers: {
              "X-CSRF-TOKEN": "{{ csrfToken }}",
              Accept: "application/json"
            }
          }).then(res => res.json()).then(data => {
            if (data.success) window.location.href = "/parent/appointments";
            else alert("Erreur: " + (data.message || "Action impossible"));
          });
        }
      }
    </script>
  @endsection
