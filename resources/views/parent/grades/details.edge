    @endif

    <script>
      let subjectChart;

      function renderChart() {
        const canvas = document.getElementById("subjectEvolutionChart");
        if (!canvas) return;

        const ctx = canvas.getContext("2d");
        subjectChart = new Chart(ctx, {
          type: "line",
          data: {
            labels: {{ evalLabels|json_encode|raw }},
            datasets: [ {
              label: window.AppTranslations?.translate("Note de l'élève") || "Note de l'élève",
              data: {{ evalScores|json_encode|raw }},
              borderColor: "#2563eb",
              backgroundColor: "rgba(37, 99, 235, 0.1)",
              fill: true,
              tension: .4
            }, {
              label: window.AppTranslations?.translate("Moyenne de la classe") || "Moyenne de la classe",
              data: {{ evalClassAverages|json_encode|raw }},
              borderColor: "#16a34a",
              borderDash: [ 5, 5 ],
              fill: false
            } ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              y: {
                max: {{ subject.chartMaxScore || 20 }},
                min: 0
              }
            }
          }
        });
      }

      function printDetails() {
        window.print();
      }

      renderChart();
    </script>
  @endsection
