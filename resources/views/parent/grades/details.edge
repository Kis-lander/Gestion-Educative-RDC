                <tr>
                  <th class="px-4 py-3">Type</th>
                  <th class="px-4 py-3 text-center">Date</th>
                  <th class="px-4 py-3 text-center">Note /20</th>
                  <th class="px-4 py-3 text-left">Appreciation</th>
                  <th class="px-4 py-3 text-center">Moyenne classe</th>
                </tr>
              </thead>
              <tbody>
                @each(grade in gradesDetails)
                  <tr class="border-b dark:border-gray-700">
                    <td class="px-4 py-3 font-medium">
                      {{ grade.type }}
                    </td>
                    <td class="px-4 py-3 text-center">
                      {{ grade.date }}
                    </td>
                    <td class="px-4 py-3 text-center">
                      <span class="font-bold {{ grade.score >= 15 ? 'text-green-600' : (grade.score >= 10 ? 'text-yellow-600' : 'text-red-600') }}">
                        {{ grade.score }}/20
                      </span>
                    </td>
                    <td class="px-4 py-3 text-gray-600 dark:text-gray-300">
                      {{ grade.comment || '-' }}
                    </td>
                    <td class="px-4 py-3 text-center">
                      {{ grade.classAverage || '-' }}/20
                    </td>
                  </tr>
                @else
                  <tr>
                    <td colspan="5" class="px-4 py-10 text-center text-gray-500">
                      Aucune evaluation disponible pour cette matiere
                    </td>
                  </tr>
                @end
              </tbody>
            </table>
          </div>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-5">
          <h3 class="font-semibold mb-4">
            Evolution des notes dans la matiere
          </h3>
          <div class="relative h-72">
            <canvas id="subjectEvolutionChart"></canvas>
          </div>
        </div>

        <div class="bg-blue-50 dark:bg-blue-900/20 rounded-xl p-5">
          <div class="flex gap-3">
            <i class="fas fa-lightbulb text-yellow-500 text-xl mt-0.5"></i>
            <div>
              <h4 class="font-semibold">
                Conseils pour progresser
              </h4>
              <p class="text-sm text-gray-700 dark:text-gray-300 mt-1">
                {{ subject.tips || 'Continuez vos efforts et n\'hesitez pas a demander de l\'aide a votre professeur.' }}
              </p>
            </div>
          </div>
        </div>
      </div>
    @endif

    <script>
      let subjectChart;

      function renderChart() {
        const canvas = document.getElementById("subjectEvolutionChart");
        if (!canvas) return;

        const ctx = canvas.getContext("2d");
        subjectChart = new Chart(ctx, {
          type: "line",
          data: {
            labels: {{ evalLabels|json_encode|raw }},
            datasets: [ {
              label: "Note de l'eleve",
              data: {{ evalScores|json_encode|raw }},
              borderColor: "#2563eb",
              backgroundColor: "rgba(37, 99, 235, 0.1)",
              fill: true,
              tension: .4
            }, {
              label: "Moyenne de la classe",
              data: {{ evalClassAverages|json_encode|raw }},
              borderColor: "#16a34a",
              borderDash: [ 5, 5 ],
              fill: false
            } ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
              y: {
                max: 20,
                min: 0
              }
            }
          }
        });
      }

      function printDetails() {
        window.print();
      }

      renderChart();
    </script>
  @endsection
