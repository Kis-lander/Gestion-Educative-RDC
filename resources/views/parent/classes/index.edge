            <div class="p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
              <p class="text-gray-500">Effectif</p>
              <p class="font-semibold">{{ classObj.current_enrollment || 0 }}/{{ classObj.max_capacity || '-' }}</p>
            </div>
            <div class="p-3 bg-gray-50 dark:bg-gray-700 rounded-lg">
              <p class="text-gray-500">Niveau</p>
