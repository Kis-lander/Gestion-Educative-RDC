  @section('content')
    <div class="grid h-[78vh] overflow-hidden rounded-[22px] border border-gray-200 bg-white shadow-xl dark:border-gray-700 dark:bg-gray-900 lg:grid-cols-[320px_1fr]">
      <aside class="hidden border-r border-gray-100 bg-gray-50/90 p-4 dark:border-gray-800 dark:bg-gray-950/60 lg:block">
        <div class="mb-4 flex items-center justify-between">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-primary">Discussions</p>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white">Messages</h3>
          </div>
          <a href="/communication/messages/compose" class="flex h-9 w-9 items-center justify-center rounded-full bg-white text-primary shadow-sm hover:bg-blue-50 dark:bg-gray-800 dark:hover:bg-gray-700" title="Nouveau message">
            <i class="fas fa-plus"></i>
          </a>
        </div>
        <div class="mb-4 flex items-center gap-2 rounded-full bg-white px-3 py-2 text-sm text-gray-500 shadow-sm dark:bg-gray-800 dark:text-gray-300">
          <i class="fas fa-search text-xs"></i>
          <span>Rechercher une discussion...</span>
        </div>
        <div class="rounded-2xl bg-primary p-3 text-white shadow-md">
          <div class="flex items-center gap-3">
            @if(contact.avatarUrl)
              <span class="relative inline-flex h-11 w-11 shrink-0">
                <img
                  src="{{ contact.avatarUrl }}"
                  alt="Photo de profil de {{ contact.name }}"
                  class="h-11 w-11 rounded-full object-cover border border-white/30"
                  onerror="this.closest('span').innerHTML='<div class=&quot;flex h-11 w-11 items-center justify-center rounded-full bg-white/20 font-bold&quot;>{{ contact.name.charAt(0) }}</div>'"
                />
              </span>
            @else
              <div class="flex h-11 w-11 items-center justify-center rounded-full bg-white/20 font-bold">
                {{ contact.name.charAt(0) }}
              </div>
            @endif
            <div class="min-w-0">
              <p class="truncate font-semibold">{{ contact.name }}</p>
              <p class="truncate text-xs text-blue-100">{{ contact.role }}</p>
            </div>
          </div>
        </div>
      </aside>

      <section class="flex min-h-0 min-w-0 flex-col bg-[#f5f7fb] dark:bg-gray-900">
      <!-- En-tête conversation -->
      <div class="border-b border-gray-200 bg-white px-5 py-4 dark:border-gray-800 dark:bg-gray-900">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            @if(contact.avatarUrl)
              <span class="relative inline-flex h-10 w-10 shrink-0">
                <img
                  src="{{ contact.avatarUrl }}"
                  alt="Photo de profil de {{ contact.name }}"
                  class="h-10 w-10 rounded-full object-cover border border-gray-200 dark:border-gray-600"
                  onerror="this.closest('span').innerHTML='<div class=&quot;w-10 h-10 rounded-full bg-primary flex items-center justify-center text-white font-bold&quot;>{{ contact.name.charAt(0) }}</div>'"
                />
              </span>
            @else
              <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center text-white font-bold">
                {{ contact.name.charAt(0) }}
              </div>
            @endif
            <div>
              <h3 class="font-semibold">
                {{ contact.name }}
              </h3>
              <p class="text-sm text-gray-500">
                {{ contact.role }}
              </p>
            </div>
          </div>
          <div class="rounded-full bg-green-50 px-3 py-1 text-sm font-medium text-green-700 dark:bg-green-900/30 dark:text-green-200">
            {{ contact.status || 'En ligne' }}
          </div>
        </div>
      </div>

      <!-- Zone des messages -->
      <div id="conversationMessages" class="flex-1 overflow-y-auto bg-[#eef2f7] p-5 dark:bg-gray-950">
        <div class="text-center py-12">
          <i class="fas fa-spinner fa-spin text-primary text-2xl"></i>
          <p class="text-gray-500 mt-2">
            Chargement des messages...
          </p>
        </div>
      </div>

      <!-- Zone de saisie -->
      <div class="border-t border-gray-200 bg-white p-3 dark:border-gray-800 dark:bg-gray-900 sm:p-4">
        <form id="messageForm" onsubmit="event.preventDefault(); sendMessage()" class="min-w-0 space-y-2">
          <div id="replyPreview" class="hidden min-w-0 overflow-hidden rounded-lg border-l-4 border-primary bg-blue-50 p-3 text-sm text-blue-900 dark:bg-blue-900/20 dark:text-blue-100"></div>
          <div class="flex min-w-0 items-end gap-2">
          <input type="hidden" id="receiverId" value="{{ contact.id }}" />
          <textarea
            id="messageContent"
            name="content"
            rows="2"
            class="min-h-[54px] min-w-0 flex-1 resize-none rounded-2xl border border-gray-200 bg-gray-100 px-4 py-3 text-sm focus:ring-2 focus:ring-primary dark:border-gray-700 dark:bg-gray-800"
            placeholder="Écrivez votre message..."
          ></textarea>
          <div class="flex shrink-0 flex-col gap-2">
            <button type="submit" class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary text-white hover:bg-blue-700 sm:w-12">
              <i class="fas fa-paper-plane"></i>
            </button>
            <button
              type="button"
              onclick="document.getElementById('fileInput').click()"
              class="flex h-10 w-10 items-center justify-center rounded-lg border hover:bg-gray-50 sm:w-12"
            >
              <i class="fas fa-paperclip"></i>
            </button>
            <input
              type="file"
              id="fileInput"
              class="hidden"
              accept=".pdf,.jpg,.jpeg,.png,.webp,.doc,.docx,.xls,.xlsx,.txt,.zip"
            />
          </div>
          </div>
          <div id="selectedFilePreview" class="hidden rounded-lg border border-blue-200 bg-blue-50 p-2 text-sm text-blue-900 dark:border-blue-800 dark:bg-blue-900/20 dark:text-blue-100"></div>
        </form>
        <p class="text-xs text-gray-400 mt-2">
          <i class="fas fa-lock mr-1"></i>Messages privés et sécurisés
        </p>
      </div>
    </div>

    <script>
      let lastMessageId = 0;

      let selectedFile = null;
      let replyingToMessage = null;
      let editingMessage = null;
      let currentMessages = [];

      function avatarHtml(url, name, sizeClass = "h-8 w-8") {
        const initial = escapeHtml((name || "M").trim().charAt(0).toUpperCase() || "M");
        const safeName = escapeHtml(name || "Membre");
        const fallbackClasses = `${sizeClass} flex shrink-0 items-center justify-center rounded-full bg-primary text-sm font-bold text-white`;
        const fallback = `<div class="${fallbackClasses}">${initial}</div>`;
        if (!url) return fallback;

        return `
          <span class="relative inline-flex ${sizeClass} shrink-0">
            <img
              src="${escapeHtml(url)}"
              alt="Photo de profil de ${safeName}"
              class="${sizeClass} rounded-full border border-gray-200 object-cover dark:border-gray-600"
              onerror="this.classList.add('hidden'); this.nextElementSibling.classList.remove('hidden')"
            />
            <span class="hidden ${fallbackClasses}">${initial}</span>
          </span>
        `;
      }

      async function loadMessages() {
        const receiverId = document.getElementById("receiverId").value;
        const res = await fetch(`/api/messages/conversation/${receiverId}`);
        const data = await res.json();
        if (data.success) window.dispatchEvent(new CustomEvent("messages:read"));
        const container = document.getElementById("conversationMessages");
        if (data.messages && data.messages.length > 0) {
          currentMessages = data.messages;
          const messagesHtml = data.messages.map(msg => `
                  <div class="mb-5 flex ${msg.isMine ? "justify-end" : "justify-start"}">
                    <div class="flex w-fit max-w-[min(76%,42rem)] min-w-0 flex-col ${msg.isMine ? "items-end" : "items-start"}">
                      <div class="mb-1.5 flex items-center gap-2 px-1 ${msg.isMine ? "justify-end" : "justify-start"}">
                        ${!msg.isMine ? avatarHtml(msg.senderAvatarUrl, msg.senderName) : ""}
                        <p class="truncate text-xs font-semibold text-gray-500 dark:text-gray-400">${escapeHtml(msg.senderName || "Membre")}</p>
                        ${msg.isMine ? avatarHtml(msg.senderAvatarUrl, msg.senderName) : ""}
                      </div>
                      <div class="max-w-full rounded-2xl border px-4 py-3 shadow-sm ${msg.isMine ? "rounded-br-md border-primary bg-primary text-white" : "rounded-bl-md border-gray-300 bg-gray-200 text-gray-900 dark:border-gray-700 dark:bg-gray-800 dark:text-white"}">
                        ${replyQuoteHtml(msg)}
                        ${msg.content ? `<p class="break-words text-sm whitespace-pre-wrap">${escapeHtml(msg.content)}</p>` : ""}
                        ${forumLinkHtml(msg)}
                        ${attachmentHtml(msg)}
                      </div>
                      <div class="mt-1.5 flex w-full items-center gap-2 ${msg.isMine ? "justify-end" : "justify-start"}">
                        <span class="text-xs text-gray-400">${msg.time}${msg.edited ? " · modifié" : ""}</span>
                        <div class="inline-flex items-center gap-0.5 rounded-full bg-gray-100 px-1 py-0.5 dark:bg-gray-800/80">
                          <button type="button" onclick="replyToMessageById('${msg.id}')" class="inline-flex h-6 w-6 items-center justify-center rounded-full text-primary transition hover:bg-primary/10" title="Répondre" aria-label="Répondre">
                            <i class="fas fa-reply text-[11px]"></i>
                          </button>
                          ${msg.canEdit ? `<button type="button" onclick="startEditMessageById('${msg.id}')" class="inline-flex h-6 w-6 items-center justify-center rounded-full text-yellow-500 transition hover:bg-yellow-500/10" title="Modifier" aria-label="Modifier"><i class="fas fa-pen text-[11px]"></i></button>` : ""}
                          ${msg.canDelete ? `<button type="button" onclick="deleteMessage('${msg.id}')" class="inline-flex h-6 w-6 items-center justify-center rounded-full text-red-500 transition hover:bg-red-500/10" title="Supprimer" aria-label="Supprimer"><i class="fas fa-trash text-[11px]"></i></button>` : ""}
                        </div>
                        ${msg.isMine && msg.read ? '<i class="fas fa-check-double text-xs text-primary"></i>' : ""}
                      </div>
                    </div>
                  </div>
                `).join("");
          container.innerHTML = messagesHtml;
          container.scrollTop = container.scrollHeight;
          if (data.messages.length > 0) {
            lastMessageId = data.messages[data.messages.length - 1].id;
          }
        } else {
          currentMessages = [];
          container.innerHTML = `
                  <div class="text-center text-gray-500 py-12">
                    <i class="fas fa-comment-dots text-4xl mb-3 block"></i>
                    <p>Aucun message. Commencez la conversation !</p>
                  </div>
                `;
        }
      }

      document.getElementById("fileInput")?.addEventListener("change", function(e) {
        selectedFile = e.target.files[0];
        renderSelectedFilePreview();
      });

      async function sendMessage() {
        const content = document.getElementById("messageContent").value.trim();
        const receiverId = document.getElementById("receiverId").value;
        if (editingMessage) return updateMessage();
        if (!content && !selectedFile) return;

        let res;

        if (selectedFile) {
          const formData = new FormData();
          formData.append("receiverId", receiverId);
          formData.append("subject", "Conversation");
          formData.append("content", content || "Fichier joint");
          if (replyingToMessage) formData.append("parentMessageId", replyingToMessage.id);
          formData.append("attachment", selectedFile);
          res = await fetch("/api/messages/send", {
            method: "POST",
            headers: {
              "X-CSRF-TOKEN": "{{ csrfToken }}"
            },
            body: formData
          });
        } else {
          res = await fetch("/api/messages/send", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-CSRF-TOKEN": "{{ csrfToken }}"
            },
            body: JSON.stringify({
              receiverId: receiverId,
              subject: "Conversation",
              content: content,
              parentMessageId: replyingToMessage?.id || null
            })
          });
        }

        const data = await res.json();
        if (data.success) {
          document.getElementById("messageContent").value = "";
          clearReply();
          removeSelectedFile();
          loadMessages();
        } else {
          alert("Erreur: " + data.message);
        }
      }

      async function updateMessage() {
        const content = document.getElementById("messageContent").value.trim();
        if (!content || !editingMessage) return;

        const res = await fetch(`/api/messages/${editingMessage.id}`, {
          method: "PUT",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-TOKEN": "{{ csrfToken }}"
          },
          body: JSON.stringify({ content })
        });

        const data = await res.json();
        if (data.success) {
          editingMessage = null;
          document.getElementById("messageContent").value = "";
          clearReply();
          loadMessages();
        } else {
          alert("Erreur: " + data.message);
        }
      }

      async function deleteMessage(messageId) {
        if (!confirm("Supprimer ce message ?")) return;
        const res = await fetch(`/api/messages/${messageId}`, {
          method: "DELETE",
          headers: {
            "X-CSRF-TOKEN": "{{ csrfToken }}"
          }
        });
        const data = await res.json();
        if (data.success) loadMessages(); else alert("Erreur: " + data.message);
      }

      function findMessage(messageId) {
        return currentMessages.find((message) => String(message.id) === String(messageId));
      }

      function replyToMessageById(messageId) {
        const message = findMessage(messageId);
        if (message) replyToMessage(message);
      }

      function startEditMessageById(messageId) {
        const message = findMessage(messageId);
        if (message) startEditMessage(message);
      }

      function replyToMessage(message) {
        replyingToMessage = message;
        editingMessage = null;
        renderReplyPreview();
        document.getElementById("messageContent").focus();
      }

      function startEditMessage(message) {
        editingMessage = message;
        replyingToMessage = null;
        document.getElementById("messageContent").value = message.content || "";
        renderReplyPreview();
        document.getElementById("messageContent").focus();
      }

      function clearReply() {
        replyingToMessage = null;
        editingMessage = null;
        renderReplyPreview();
      }

      function renderReplyPreview() {
        const preview = document.getElementById("replyPreview");
        if (!preview) return;

        const source = editingMessage || replyingToMessage;
        if (!source) {
          preview.classList.add("hidden");
          preview.innerHTML = "";
          return;
        }

        const title = editingMessage ? "Modification de votre message" : `Réponse à ${escapeHtml(source.senderName || "ce message")}`;
        const content = escapeHtml(source.content || source.attachmentName || "Fichier joint");
        preview.innerHTML = `
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 overflow-hidden">
              <p class="font-semibold">${title}</p>
              <p class="truncate opacity-80">${content}</p>
            </div>
            <button type="button" onclick="clearReply()" class="shrink-0 rounded px-2 py-1 hover:bg-blue-100 dark:hover:bg-blue-800">
              <i class="fas fa-times"></i>
            </button>
          </div>
        `;
        preview.classList.remove("hidden");
      }

      function replyQuoteHtml(msg) {
        if (!msg.parentMessage) return "";
        return `
          <div class="mb-2 rounded border-l-4 border-white/60 bg-black/10 px-2 py-1 text-xs">
            <p class="font-semibold">${escapeHtml(msg.parentMessage.authorName)}</p>
            <p class="truncate opacity-80">${escapeHtml(msg.parentMessage.content || msg.parentMessage.attachmentName || "Fichier joint")}</p>
          </div>
        `;
      }

      function forumLinkHtml(msg) {
        if (!msg.forumLink) return "";
        return `
          <a
            href="${escapeHtml(msg.forumLink)}"
            class="mt-2 inline-flex items-center gap-2 rounded-lg bg-white/15 px-3 py-2 text-xs font-semibold underline-offset-2 hover:underline"
          >
            <i class="fas fa-comments"></i>
            ${escapeHtml(window.AppTranslations?.translate("Ouvrir dans le forum") || "Ouvrir dans le forum")}
          </a>
        `;
      }

      function attachmentHtml(msg) {
        if (!msg.attachmentUrl) return "";

        const name = escapeHtml(msg.attachmentName || "Fichier joint");
        const url = escapeHtml(msg.attachmentUrl);
        const downloadUrl = escapeHtml(msg.attachmentDownloadUrl || msg.attachmentUrl);
        const downloadLink = `<a href="${downloadUrl}" class="text-xs underline mt-2 inline-block"><i class="fas fa-download mr-1"></i>${name}</a>`;

        if (msg.attachmentIsImage) {
          return `
            <div class="mt-2">
              <a href="${url}" target="_blank" class="block">
                <img src="${url}" alt="${name}" class="max-h-48 max-w-full rounded-lg border border-white/20 object-contain bg-white" />
              </a>
              ${downloadLink}
            </div>
          `;
        }

        return `<div class="mt-2">${downloadLink}</div>`;
      }

      function formatSelectedFileSize(size) {
        if (!size) return "-";
        if (size < 1024 * 1024) return `${Math.max(1, Math.round(size / 1024))} Ko`;
        return `${(size / 1024 / 1024).toFixed(1)} Mo`;
      }

      function renderSelectedFilePreview() {
        const preview = document.getElementById("selectedFilePreview");
        if (!preview) return;

        if (!selectedFile) {
          preview.classList.add("hidden");
          preview.innerHTML = "";
          return;
        }

        const icon = selectedFile.type.startsWith("image/") ? "fa-image" : "fa-file-lines";
        preview.innerHTML = `
          <div class="flex items-center justify-between gap-3">
            <div class="flex min-w-0 items-center gap-2">
              <i class="fas ${icon}"></i>
              <span class="truncate font-medium">${escapeHtml(selectedFile.name)}</span>
              <span class="shrink-0 text-xs opacity-75">${formatSelectedFileSize(selectedFile.size)}</span>
            </div>
            <button type="button" onclick="removeSelectedFile()" class="shrink-0 rounded px-2 py-1 hover:bg-blue-100 dark:hover:bg-blue-800">
              <i class="fas fa-times"></i>
            </button>
          </div>
        `;
        preview.classList.remove("hidden");
      }

      function removeSelectedFile() {
        selectedFile = null;
        const fileInput = document.getElementById("fileInput");
        if (fileInput) fileInput.value = "";
        renderSelectedFilePreview();
      }

      function escapeHtml(text) {
        const div = document.createElement("div");
        div.textContent = text;
        return div.innerHTML;
      }

      function exportConversation() {
        const receiverId = document.getElementById("receiverId").value;
        window.location.href = `/api/messages/conversation/${receiverId}/export`;
      }

      loadMessages();

      setInterval(() => {
        if (document.visibilityState === "visible") {
          loadMessages();
        }
      }, 1e4);
    </script>
  @endsection
  
