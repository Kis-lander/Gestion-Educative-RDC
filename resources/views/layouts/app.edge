<!DOCTYPE html>
<html lang="{{ appLanguage || 'fr' }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="{{ csrfToken }}" />
    <meta name="theme-color" content="#2563eb" />
    <title>
      {{ title || 'Gestion Éducative RDC' }}
    </title>

    <!-- Tailwind CSS CDN (minifié pour low bandwidth) -->
    <script src="https://cdn.tailwindcss.com">

    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js">

    </script>
    <script>
      (() => {
        const path = window.location.pathname;
        const surface = path.includes("/forum") ? "forum" : path.includes("/messages") || path.includes("/communication/") ? "messages" : "";
        if (surface) document.documentElement.dataset.surface = surface;
      })();

      (() => {
        if (!window.Chart || window.Chart.__adaptiveHeightPatched) return;
        const NativeChart = window.Chart;
        const getDataLength = config => {
          const labelsLength = Array.isArray(config?.data?.labels) ? config.data.labels.length : 0;
          const datasetLength = (config?.data?.datasets || []).reduce((max, dataset) => {
            return Math.max(max, Array.isArray(dataset?.data) ? dataset.data.length : 0);
          }, 0);
          return Math.max(labelsLength, datasetLength);
        };
        const getAdaptiveHeight = (canvas, config) => {
          const dataLength = getDataLength(config);
          const baseHeight = Math.min(Math.max(Number(canvas.getAttribute("height")) || 240, 180), 320);
          const type = String(config?.type || "").toLowerCase();
          if ([ "doughnut", "pie", "polararea", "radar" ].includes(type)) {
            return Math.min(Math.max(baseHeight, 220 + Math.max(dataLength - 12, 0) * 14), 480);
          }
          if (type === "bar") {
            return Math.min(Math.max(baseHeight, 220 + Math.max(dataLength - 18, 0) * 14), 560);
          }
          return Math.min(Math.max(baseHeight, 220 + Math.max(dataLength - 24, 0) * 8), 460);
        };
        function AdaptiveChart(item, config) {
          config.options = config.options || {};
          config.options.maintainAspectRatio = false;
          const chart = new NativeChart(item, config);
          const canvas = chart.canvas;
          if (canvas) {
            const height = getAdaptiveHeight(canvas, config);
            canvas.style.display = "block";
            canvas.style.width = "100%";
            canvas.style.height = `${height}px`;
            canvas.height = height;
            chart.options.maintainAspectRatio = false;
            chart.resize();
          }
          return chart;
        }
        Object.setPrototypeOf(AdaptiveChart, NativeChart);
        AdaptiveChart.prototype = NativeChart.prototype;
        Object.assign(AdaptiveChart, NativeChart);
        AdaptiveChart.__adaptiveHeightPatched = true;
        window.Chart = AdaptiveChart;
      })();
    </script>

    <!-- Configuration Tailwind pour mode sombre -->
    <script>
      window.__APP_LANGUAGE__ = "{{ appLanguage || 'fr' }}";

      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#2563eb",
              secondary: "#16a34a",
              danger: "#dc2626",
              warning: "#f59e0b"
            }
          }
        }
      };
    </script>

    <!-- Font Awesome (version allégée) -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />

    <!-- Google Fonts - Inter (chargement optimisé) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <style>
      .inspection-chart-card {
        height: 490px;
        display: flex;
        flex-direction: column;
      }
      
      .inspection-chart-body {
        position: relative;
        width: 100%;
        flex: 1 1 auto;
        min-height: 0;
      }
      
      .inspection-chart-body canvas {
        width: 100% !important;
        height: 100% !important;
      }
      
      @media (max-width: 1023px) {
        .inspection-chart-card {
          height: 420px;
        }
      }
      
      @media (max-width: 640px) {
        .inspection-chart-card {
          height: 360px;
        }
      }
      
      :root {
        --school-ink: #172033;
        --school-muted: #667085;
        --school-line: #d9e2ef;
        --school-soft-line: rgba(148, 163, 184, 0.28);
        --school-surface: rgba(255, 255, 255, 0.92);
        --school-field: #f8fafc;
        --school-page: #eef3f8;
        --school-page-2: #f8fafc;
        --school-primary: #1d4ed8;
        --school-primary-2: #2563eb;
        --school-shadow: 0 16px 38px rgba(15, 23, 42, 0.08), 0 2px 8px rgba(15, 23, 42, 0.04);
      }
      
      * {
        font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        letter-spacing: 0;
      }
      
      [x-cloak] {
        display: none !important;
      }
      
      body {
        min-height: 100vh;
        background: radial-gradient(circle at top left, rgba(37, 99, 235, 0.1), transparent 32rem),
                linear-gradient(180deg, var(--school-page-2) 0%, var(--school-page) 100%);
        transition: background-color 0.3s ease;
        overflow-x: hidden;
        color: var(--school-ink);
      }
      
      html:not(.dark) header {
        background: rgba(255, 255, 255, 0.88) !important;
        border-bottom: 1px solid rgba(15, 23, 42, 0.08);
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08) !important;
        backdrop-filter: blur(16px);
      }
      
      html:not(.dark) aside {
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.96)) !important;
        border-right: 1px solid rgba(148, 163, 184, 0.26);
        box-shadow: 18px 0 42px rgba(15, 23, 42, 0.08) !important;
      }
      
      html:not(.dark) aside nav a {
        font-weight: 650;
        color: #344054;
      }
      
      html:not(.dark) aside nav a:hover {
        background-color: #eef4ff !important;
        color: #1d4ed8 !important;
      }
      
      html:not(.dark) aside nav a.bg-primary {
        background: linear-gradient(135deg, #1d4ed8, #2563eb) !important;
        box-shadow: 0 12px 24px rgba(37, 99, 235, 0.22) !important;
      }
      
      html:not(.dark) main {
        background: linear-gradient(180deg, rgba(248, 250, 252, 0.78), rgba(238, 243, 248, 0.98)),
                radial-gradient(circle at 100% 0, rgba(15, 159, 110, 0.08), transparent 26rem);
      }
      
      html:not(.dark) main > div {
        max-width: 1480px;
        margin: 0 auto;
      }
      
      html:not(.dark) [data-page-header] {
        margin: -0.25rem -0.25rem 1.55rem;
        padding: 0.25rem;
      }
      
      html:not(.dark) [data-page-header] h1,
      html:not(.dark) h1,
      html:not(.dark) h2,
      html:not(.dark) h3 {
        font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
        color: var(--school-ink) !important;
      }
      
      html:not(.dark) [data-page-header] h1 {
        font-weight: 800;
      }
      
      html:not(.dark) [data-page-header] p {
        color: var(--school-muted) !important;
        font-size: 1rem;
      }
      
      html:not(.dark) main .bg-white,
      html:not(.dark) main .shadow-md,
      html:not(.dark) main .shadow-lg,
      html:not(.dark) main .shadow-xl {
        border: 1px solid var(--school-soft-line);
        background: var(--school-surface) !important;
        box-shadow: var(--school-shadow) !important;
        backdrop-filter: blur(8px);
      }
      
      html:not(.dark) main .bg-gray-50,
      html:not(.dark) main .bg-gray-100 {
        background-color: #f4f7fb !important;
        border-color: var(--school-line) !important;
      }
      
      html:not(.dark) main .rounded-xl {
        border-radius: 14px !important;
      }
      
      html:not(.dark) main .rounded-lg {
        border-radius: 10px !important;
      }
      
      html:not(.dark) main .text-gray-900,
      html:not(.dark) main .text-gray-800,
      html:not(.dark) main .text-gray-700 {
        color: var(--school-ink) !important;
      }
      
      html:not(.dark) main .text-gray-600,
      html:not(.dark) main .text-gray-500,
      html:not(.dark) main .text-gray-400 {
        color: var(--school-muted) !important;
      }
      
      html:not(.dark) main a.text-primary,
      html:not(.dark) main .text-primary {
        color: var(--school-primary) !important;
      }
      
      html:not(.dark) main .bg-primary {
        background: linear-gradient(135deg, var(--school-primary), var(--school-primary-2)) !important;
        box-shadow: 0 10px 22px rgba(37, 99, 235, 0.22);
      }
      
      html:not(.dark) main button,
      html:not(.dark) main a {
        transition: background-color 0.18s ease,
                border-color 0.18s ease,
                box-shadow 0.18s ease,
                color 0.18s ease,
                transform 0.18s ease;
      }
      
      html:not(.dark) main button:hover,
      html:not(.dark) main a:hover {
        transform: translateY(-1px);
      }
      
      html:not(.dark) main button.border,
      html:not(.dark) main a.border {
        background: rgba(255, 255, 255, 0.78);
        border-color: #cbd5e1 !important;
        color: #344054;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
      }
      
      html:not(.dark) main button.border:hover,
      html:not(.dark) main a.border:hover {
        background: #eef4ff !important;
        border-color: #93b4f7 !important;
        color: #1d4ed8 !important;
      }
      
      html:not(.dark) main table {
        overflow: hidden;
        border-color: var(--school-line) !important;
      }
      
      html:not(.dark) main thead,
      html:not(.dark) main th {
        background: linear-gradient(180deg, #f8fafc, #edf3fb) !important;
        color: #344054 !important;
        font-size: 0.75rem;
        font-weight: 800;
        letter-spacing: 0.02em;
        text-transform: uppercase;
      }
      
      html:not(.dark) main tbody tr {
        border-color: #e5edf6 !important;
      }
      
      html:not(.dark) main tbody tr:hover {
        background-color: #f7fbff !important;
      }
      
      html:not(.dark) main label {
        color: #344054 !important;
        font-weight: 700;
      }
      
      html[data-surface='forum'] main,
      html[data-surface='messages'] main {
        --thread-card: rgba(255, 255, 255, 0.9);
        --thread-card-muted: rgba(241, 245, 249, 0.92);
        --thread-border: rgba(148, 163, 184, 0.32);
        --thread-shadow: 0 10px 24px rgba(15, 23, 42, 0.07);
        --thread-shadow-soft: 0 6px 16px rgba(15, 23, 42, 0.05);
      }
      
      html[data-surface='forum'].dark main,
      html[data-surface='messages'].dark main {
        --thread-card: rgba(31, 41, 55, 0.92);
        --thread-card-muted: rgba(15, 23, 42, 0.7);
        --thread-border: rgba(148, 163, 184, 0.24);
        --thread-shadow: 0 12px 30px rgba(0, 0, 0, 0.22);
        --thread-shadow-soft: 0 8px 18px rgba(0, 0, 0, 0.16);
      }
      
      html[data-surface='forum'] main .rounded-xl,
      html[data-surface='messages'] main .rounded-xl {
        border-radius: 14px !important;
      }
      
      html[data-surface='forum'] main .rounded-2xl,
      html[data-surface='messages'] main .rounded-2xl {
        border-radius: 14px !important;
      }
      
      html[data-surface='forum'] main .p-4.rounded-2xl,
      html[data-surface='messages'] main .p-4.rounded-2xl,
      html[data-surface='forum'] main .rounded-2xl.p-4,
      html[data-surface='messages'] main .rounded-2xl.p-4 {
        padding: 0.65rem 0.85rem !important;
      }
      
      html[data-surface='forum'] main .p-3.rounded-2xl,
      html[data-surface='messages'] main .p-3.rounded-2xl,
      html[data-surface='forum'] main .rounded-2xl.p-3,
      html[data-surface='messages'] main .rounded-2xl.p-3 {
        padding: 0.55rem 0.75rem !important;
      }
      
      html[data-surface='forum'] main .shadow-md,
      html[data-surface='forum'] main .shadow-lg,
      html[data-surface='forum'] main .shadow-xl,
      html[data-surface='messages'] main .shadow-md,
      html[data-surface='messages'] main .shadow-lg,
      html[data-surface='messages'] main .shadow-xl {
        box-shadow: var(--thread-shadow) !important;
      }
      
      html[data-surface='forum'] main .shadow-sm,
      html[data-surface='messages'] main .shadow-sm {
        box-shadow: var(--thread-shadow-soft) !important;
      }
      
      html[data-surface='forum'] main .border,
      html[data-surface='messages'] main .border {
        border-color: var(--thread-border) !important;
      }
      
      html[data-surface='forum'] main .bg-gray-100,
      html[data-surface='forum'] main .bg-gray-200,
      html[data-surface='messages'] main .bg-gray-100,
      html[data-surface='messages'] main .bg-gray-200 {
        background-color: var(--thread-card-muted) !important;
      }
      
      html[data-surface='forum'] main .max-w-\[82\%\],
      html[data-surface='messages'] main .max-w-\[82\%\] {
        max-width: min(72%, 34rem) !important;
      }
      
      html[data-surface='forum'] main .max-w-\[78\%\],
      html[data-surface='messages'] main .max-w-\[78\%\],
      html[data-surface='forum'] main .max-w-\[70\%\],
      html[data-surface='messages'] main .max-w-\[70\%\] {
        max-width: min(74%, 38rem) !important;
      }
      
      html[data-surface='forum'] main textarea,
      html[data-surface='messages'] main textarea,
      html[data-surface='forum'] main input,
      html[data-surface='messages'] main input,
      html[data-surface='forum'] main select,
      html[data-surface='messages'] main select {
        border-color: var(--thread-border) !important;
      }
      
      .dark body {
        background: radial-gradient(circle at top left, rgba(37, 99, 235, 0.14), transparent 30rem),
                linear-gradient(180deg, #0f172a 0%, #111827 100%);
        color: #e5e7eb;
      }
      
      .dark main {
        background: linear-gradient(180deg, rgba(15, 23, 42, 0.96), rgba(17, 24, 39, 0.98)),
                radial-gradient(circle at 100% 0, rgba(22, 163, 74, 0.08), transparent 26rem);
        color: #e5e7eb;
      }
      
      .dark [data-page-header] h1,
      .dark main h1,
      .dark main h2,
      .dark main h3 {
        color: #f8fafc !important;
        text-shadow: none !important;
      }
      
      .dark [data-page-header] p,
      .dark main p,
      .dark main .text-gray-500,
      .dark main .text-gray-400 {
        color: #cbd5e1 !important;
      }
      
      .dark [data-page-header] button {
        background-color: rgba(15, 23, 42, 0.72);
        border-color: #64748b !important;
        color: #e2e8f0 !important;
      }
      
      .dark .bg-white {
        background-color: #1f2937 !important;
      }
      
      .dark main .bg-white,
      .dark main .dark\:bg-gray-800,
      .dark main .shadow-md,
      .dark main .shadow-lg,
      .dark main .shadow-xl {
        border-color: rgba(148, 163, 184, 0.22) !important;
        background-color: #1f2937 !important;
      }
      
      .dark .bg-gray-50,
      .dark .bg-gray-100 {
        background-color: #111827 !important;
      }
      
      .dark .text-gray-900,
      .dark .text-gray-800,
      .dark .text-gray-700 {
        color: #f9fafb !important;
      }
      
      .dark .text-gray-600,
      .dark .text-gray-500,
      .dark .text-gray-400 {
        color: #d1d5db !important;
      }
      
      .dark main label,
      .dark main strong,
      .dark main th,
      .dark main td,
      .dark main span {
        color: inherit;
      }
      
      .dark main label {
        color: #e5e7eb !important;
        font-weight: 700;
      }
      
      .dark main strong {
        color: #f8fafc;
      }
      
      .dark main .bg-blue-100,
      .dark main .bg-blue-50,
      .dark main .bg-indigo-100,
      .dark main .bg-indigo-50,
      .dark main .bg-purple-100,
      .dark main .bg-purple-50,
      .dark main .bg-green-100,
      .dark main .bg-green-50,
      .dark main .bg-yellow-100,
      .dark main .bg-yellow-50,
      .dark main .bg-orange-100,
      .dark main .bg-orange-50,
      .dark main .bg-red-100,
      .dark main .bg-red-50,
      .dark main .bg-pink-100,
      .dark main .bg-pink-50,
      .dark main .bg-cyan-100,
      .dark main .bg-cyan-50,
      .dark main .bg-teal-100,
      .dark main .bg-teal-50,
      .dark main .bg-gray-100,
      .dark main .bg-gray-50 {
        border: 1px solid rgba(148, 163, 184, 0.22);
      }
      
      .dark main .bg-blue-100,
      .dark main .bg-blue-50 {
        background-color: rgba(37, 99, 235, 0.2) !important;
      }
      
      .dark main .bg-indigo-100,
      .dark main .bg-indigo-50 {
        background-color: rgba(79, 70, 229, 0.22) !important;
      }
      
      .dark main .bg-purple-100,
      .dark main .bg-purple-50 {
        background-color: rgba(147, 51, 234, 0.22) !important;
      }
      
      .dark main .bg-green-100,
      .dark main .bg-green-50 {
        background-color: rgba(22, 163, 74, 0.2) !important;
      }
      
      .dark main .bg-yellow-100,
      .dark main .bg-yellow-50,
      .dark main .bg-orange-100,
      .dark main .bg-orange-50 {
        background-color: rgba(245, 158, 11, 0.22) !important;
      }
      
      .dark main .bg-red-100,
      .dark main .bg-red-50 {
