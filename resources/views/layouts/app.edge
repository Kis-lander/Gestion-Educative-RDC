      }
      
      .dark main .bg-pink-100,
      .dark main .bg-pink-50 {
        background-color: rgba(219, 39, 119, 0.2) !important;
      }
      
      .dark main .bg-cyan-100,
      .dark main .bg-cyan-50 {
        background-color: rgba(8, 145, 178, 0.2) !important;
      }
      
      .dark main .bg-teal-100,
      .dark main .bg-teal-50 {
        background-color: rgba(13, 148, 136, 0.2) !important;
      }
      
      .dark main .bg-gray-100,
      .dark main .bg-gray-50 {
        background-color: rgba(51, 65, 85, 0.52) !important;
      }
      
      .dark main .text-blue-600,
      .dark main .text-blue-700,
      .dark main .text-blue-800 {
        color: #93c5fd !important;
      }
      
      .dark main .text-indigo-600,
      .dark main .text-indigo-700,
      .dark main .text-indigo-800 {
        color: #a5b4fc !important;
      }
      
      .dark main .text-purple-600,
      .dark main .text-purple-700,
      .dark main .text-purple-800 {
        color: #d8b4fe !important;
      }
      
      .dark main .text-green-600,
      .dark main .text-green-700,
      .dark main .text-green-800 {
        color: #86efac !important;
      }
      
      .dark main .text-yellow-600,
      .dark main .text-yellow-700,
      .dark main .text-yellow-800,
      .dark main .text-orange-600,
      .dark main .text-orange-700,
      .dark main .text-orange-800 {
        color: #fde68a !important;
      }
      
      .dark main .text-red-600,
      .dark main .text-red-700,
      .dark main .text-red-800 {
        color: #fca5a5 !important;
      }
      
      .dark main .text-pink-600,
      .dark main .text-pink-700,
      .dark main .text-pink-800 {
        color: #f9a8d4 !important;
      }
      
      .dark main .text-cyan-600,
      .dark main .text-cyan-700,
      .dark main .text-cyan-800 {
        color: #67e8f9 !important;
      }
      
      .dark main .text-teal-600,
      .dark main .text-teal-700,
      .dark main .text-teal-800 {
        color: #5eead4 !important;
      }
      
      .dark main .text-gray-600,
      .dark main .text-gray-700,
      .dark main .text-gray-800 {
        color: #e2e8f0 !important;
      }
      
      .dark main .border-t,
      .dark main .border-b,
      .dark main .border {
        border-color: rgba(148, 163, 184, 0.28) !important;
      }
      
      html:not(.dark) main input:not([type='checkbox']):not([type='radio']):not([type='file']):not([type='range']):not([type='color']),
      html:not(.dark) main select,
      html:not(.dark) main textarea {
        background-color: var(--school-field) !important;
        border-color: #c8d3e1 !important;
        color: #111827;
        box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.04), 0 1px 0 rgba(255, 255, 255, 0.7);
        font-weight: 600;
      }
      
      html:not(.dark) main input:not([type='checkbox']):not([type='radio']):not([type='file']):not([type='range']):not([type='color']):focus,
      html:not(.dark) main select:focus,
      html:not(.dark) main textarea:focus {
        background-color: #ffffff !important;
        border-color: #2563eb !important;
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.14);
      }
      
      html:not(.dark) main input::placeholder,
      html:not(.dark) main textarea::placeholder {
        color: #98a2b3;
      }
      
      html:not(.dark) main .card-hover:hover {
        transform: translateY(-3px);
        box-shadow: 0 20px 42px rgba(15, 23, 42, 0.12) !important;
      }
      
      html:not(.dark) main .card-hover {
        position: relative;
        overflow: hidden;
      }
      
      html:not(.dark) main .card-hover::before {
        position: absolute;
        inset: 0 auto 0 0;
        width: 4px;
        content: '';
        background: linear-gradient(180deg, #2563eb, #0f9f6e);
        opacity: 0.85;
      }
      
      html:not(.dark) main .bg-blue-50,
      html:not(.dark) main .bg-green-50,
      html:not(.dark) main .bg-yellow-50,
      html:not(.dark) main .bg-red-50 {
        border: 1px solid rgba(148, 163, 184, 0.22);
      }
      
      html:not(.dark) main .bg-blue-50 {
        background-color: #eff6ff !important;
      }
      
      html:not(.dark) main .bg-green-50 {
        background-color: #ecfdf5 !important;
      }
      
      html:not(.dark) main .bg-yellow-50 {
        background-color: #fffbeb !important;
      }
      
      html:not(.dark) main .bg-red-50 {
        background-color: #fef2f2 !important;
      }
      
      html:not(.dark) main hr,
      html:not(.dark) main .border-t,
      html:not(.dark) main .border-b,
      html:not(.dark) main .border {
        border-color: var(--school-line) !important;
      }
      
      html:not(.dark) main input[readonly],
      html:not(.dark) main input:disabled,
      html:not(.dark) main select:disabled,
      html:not(.dark) main textarea:disabled {
        background-color: #e5e7eb !important;
        border-color: #cbd5e1 !important;
        color: #4b5563;
      }
      
      .dark input,
      .dark select,
      .dark textarea {
        background-color: #111827;
        border-color: #4b5563;
        color: #f9fafb;
      }
      
      .dark input::placeholder,
      .dark textarea::placeholder {
        color: #9ca3af;
      }
      
      .dark table,
      .dark thead,
      .dark tbody,
      .dark tr,
      .dark th,
      .dark td {
        border-color: #374151 !important;
        color: #e5e7eb;
      }
      
      .dark thead,
      .dark th {
        background-color: #374151;
        color: #f9fafb;
      }
      
      .dark button.border,
      .dark a.border {
        border-color: #6b7280;
        color: #e5e7eb;
      }
      
      .dark button.border:hover,
      .dark a.border:hover {
        background-color: #374151;
      }
      
      .dark .shadow-md,
      .dark .shadow-lg,
      .dark .shadow-xl {
        box-shadow: 0 18px 35px rgba(0, 0, 0, 0.3);
      }
      
      .dark main .rounded-full.bg-green-100,
      .dark main .rounded.bg-green-100 {
        background-color: rgba(22, 163, 74, 0.24) !important;
        border-color: rgba(74, 222, 128, 0.36) !important;
      }
      
      .dark main .rounded-full.bg-blue-100,
      .dark main .rounded.bg-blue-100 {
        background-color: rgba(37, 99, 235, 0.24) !important;
        border-color: rgba(147, 197, 253, 0.34) !important;
      }
      
      .dark main .rounded-full.bg-yellow-100,
      .dark main .rounded.bg-yellow-100,
      .dark main .rounded-full.bg-orange-100,
      .dark main .rounded.bg-orange-100 {
        background-color: rgba(245, 158, 11, 0.24) !important;
        border-color: rgba(253, 230, 138, 0.34) !important;
      }
      
      .dark main .rounded-full.bg-red-100,
      .dark main .rounded.bg-red-100 {
        background-color: rgba(220, 38, 38, 0.24) !important;
        border-color: rgba(252, 165, 165, 0.34) !important;
      }
      
      .dark main .rounded-full.bg-gray-100,
      .dark main .rounded.bg-gray-100 {
        background-color: rgba(51, 65, 85, 0.7) !important;
        border-color: rgba(148, 163, 184, 0.32) !important;
      }
      
      /* Loading spinner */
      
      .spinner {
        border: 3px solid #f3f4f6;
        border-top: 3px solid #2563eb;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        animation: spin 1s linear infinite;
      }
      
      @keyframes spin {
        0% {
          transform: rotate(0deg);
        }
      
        100% {
          transform: rotate(360deg);
        }
      }
      
      /* Toast notifications */
      
      .toast {
        position: fixed;
        right: 12px;
        bottom: 16px;
        left: 12px;
        z-index: 50;
        animation: slideIn 0.3s ease;
      }
      
      @media (min-width: 640px) {
        .toast {
          right: 24px;
          bottom: 24px;
          left: auto;
        }
      }
      
      @keyframes slideIn {
        from {
          transform: translateX(100%);
          opacity: 0;
        }
      
        to {
          transform: translateX(0);
          opacity: 1;
        }
      }
      
      /* Cards hover effect */
      
      .card-hover {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }
      
      .card-hover:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
      }
      
      /* Table responsive */
      
      .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
      }
      
      /* Focus visible pour accessibilité */
      
      *:focus-visible {
        outline: 2px solid #2563eb;
        outline-offset: 2px;
      }
    </style>

  </head>
  <body
    class="antialiased"
    x-data="{ 
  sidebarOpen: false, 
  darkMode: localStorage.getItem('darkMode') === 'true',
  notifications: [],
  showToast: false,
  toastMessage: '',
  toastType: 'success'
}"
    x-init="
  if (darkMode) { document.documentElement.classList.add('dark') }
  $watch('darkMode', val => {
    if (val) { document.documentElement.classList.add('dark'); localStorage.setItem('darkMode', 'true') }
    else { document.documentElement.classList.remove('dark'); localStorage.setItem('darkMode', 'false') }
  })
  window.addEventListener('show-toast', event => {
    toastMessage = event.detail?.message || ''
    toastType = event.detail?.type || 'success'
    showToast = Boolean(toastMessage)
    clearTimeout(window.__actionToastTimer)
    window.__actionToastTimer = setTimeout(() => showToast = false, 6500)
  })
"
  >

    <div
      id="app-flash-messages"
      class="hidden"
      data-success="{{ flashMessages?.get('success') || '' }}"
      data-error="{{ flashMessages?.get('error') || '' }}"
    >
    </div>

    @if(flashMessages?.get('success') || flashMessages?.get('error'))
      <div
        class="fixed left-4 right-4 top-20 z-[60] sm:left-auto sm:right-6 sm:w-full sm:max-w-md"
        role="status"
        aria-live="polite"
        x-data="{ visible: true }"
        x-show="visible"
        x-transition
        x-init="setTimeout(() => visible = false, 6500)"
      >
        <div
          class="flex items-start gap-3 rounded-lg border p-4 shadow-lg {{ flashMessages?.get('error') ? 'border-red-200 bg-red-50 text-red-800' : 'border-green-200 bg-green-50 text-green-800' }}"
        >
          <i class="fas {{ flashMessages?.get('error') ? 'fa-circle-exclamation text-red-600' : 'fa-circle-check text-green-600' }} mt-0.5"></i>
          <p class="flex-1 text-sm font-medium">
            {{ flashMessages?.get('error') || flashMessages?.get('success') }}
          </p>
          <button type="button" class="shrink-0" aria-label="Fermer le message" @click="visible = false">
            <i class="fas fa-times"></i>
          </button>
        </div>
      </div>
    @endif

    <!-- Loading Overlay -->
    <div
      x-show="$store.loading.loading"
      x-cloak
      class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center"
    >
      <div class="bg-white dark:bg-gray-800 rounded-lg p-8 flex flex-col items-center">
        <div class="spinner">
        </div>
        <p class="mt-4 text-gray-600 dark:text-gray-300">
          Chargement...
        </p>
      </div>
    </div>

    <!-- Toast Notification -->
    <div x-show="showToast" x-cloak class="toast" x-transition>
      <div
        :class="{
      'bg-green-500': toastType === 'success',
      'bg-red-500': toastType === 'error',
      'bg-blue-500': toastType === 'info',
      'bg-yellow-500': toastType === 'warning'
    }"
        class="rounded-lg shadow-lg p-4 w-full sm:min-w-[300px]"
      >
        <div class="flex items-center">
          <i
            :class="{
          'fas fa-check-circle': toastType === 'success',
          'fas fa-exclamation-circle': toastType === 'error',
          'fas fa-info-circle': toastType === 'info',
          'fas fa-exclamation-triangle': toastType === 'warning'
        }"
            class="text-white mr-3"
          ></i>
          <p class="text-white text-sm" x-text="toastMessage">
          </p>
        </div>
      </div>
    </div>

    @!include('partials/header')
    @!include('partials/sidebar')

    <!-- Main Content -->
    <main
      class="min-h-screen pt-16 transition-all duration-300"
      :class="sidebarOpen ? 'lg:ml-64' : 'lg:ml-0'"
    >
      <div class="p-4 md:p-6">
        <div class="mb-6" data-page-header>
          <div class="flex items-start gap-3">
            <button
              type="button"
              onclick="window.history.length > 1 ? window.history.back() : window.location.assign('/dashboard')"
              class="mt-1 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800"
              title="Retour"
              aria-label="Retour"
            >
              <i class="fas fa-arrow-left"></i>
            </button>
            <div>
              <h1 class="text-2xl md:text-3xl font-bold text-gray-800 dark:text-white" data-i18n>
                {{ pageHeader(request.url()).title }}
              </h1>
              <p class="text-gray-500 dark:text-gray-400 mt-1" data-i18n>
                {{ pageHeader(request.url()).subtitle }}
              </p>
            </div>
          </div>
        </div>

        @section('content')
        @endsection
      </div>
    </main>

    @!include('partials/footer')
    <script src="/js/app-translations.js?v=20260729-profile-preferences" defer>

    </script>
    @!include('partials/scripts')

  </body>
</html>
