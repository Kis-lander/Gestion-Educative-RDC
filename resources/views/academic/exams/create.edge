              <i class="fas fa-check-circle text-green-500 mt-0.5"></i>
              <span>Communiquez le planning au moins une semaine à l'avance</span>
            </li>
          </ul>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-4">
          <h3 class="font-semibold mb-2">
            Exemple d'emploi du temps
          </h3>
          <div class="text-sm space-y-1">
            <div class="flex justify-between">
              <span>Lundi 8h-10h:</span>              <span>Mathématiques - Salle A1</span>
            </div>
            <div class="flex justify-between">
              <span>Lundi 10h-12h:</span>              <span>Français - Salle A2</span>
            </div>
            <div class="flex justify-between">
              <span>Mardi 8h-10h:</span>              <span>Sciences - Salle B1</span>
            </div>
          </div>
        </div>

        <div class="bg-yellow-50 dark:bg-yellow-900/20 rounded-xl p-4">
          <p class="text-sm flex gap-2">
            <i class="fas fa-info-circle text-yellow-600"></i>
            <span data-i18n>Pour ENAFEP, TENASOSP et EXETAT, indiquez la date communiquée officiellement par le gouvernement.</span>
          </p>
        </div>
      </div>
    </div>

    <script>
      let subjectIndex = 1;
      const classEvaluationPolicies = {{ classEvaluationPolicies|json_encode|raw }};
      const fallbackTermOptions = {{ fallbackTermOptions|json_encode|raw }};
      const periodSelect = document.getElementById("periodSelect");
      const translate = (text) => window.AppTranslations?.translate(text) || text;

      function nationalExamOptionsFor(classInput, policy) {
        const gradeLevel = Number(classInput.dataset.gradeLevel || 0);
        if (policy.section === "primaire" && gradeLevel === 6) {
          return [{ value: "ENAFEP", label: "ENAFEP - Date officielle à fixer" }];
        }
        if (policy.section === "secondaire" && gradeLevel === 8) {
          return [{ value: "TENASOSP", label: "TENASOSP - Date officielle à fixer" }];
        }
        if (policy.section === "secondaire" && gradeLevel === 12) {
          return [{ value: "EXETAT", label: "EXETAT - Date officielle à fixer" }];
        }
        return [];
      }

      function renderPeriodOptions() {
        const selectedClasses = Array.from(document.querySelectorAll(".class-choice:checked"));
        const classInputs = selectedClasses.length
          ? selectedClasses
          : Array.from(document.querySelectorAll(".class-choice"));
        const optionsByValue = new Map();

        classInputs.forEach((classInput) => {
          const policy = classEvaluationPolicies[classInput.value];
          if (!policy) return;
          (policy.periods || []).forEach((period) => optionsByValue.set(period.value, period.label));
          nationalExamOptionsFor(classInput, policy).forEach((exam) =>
            optionsByValue.set(exam.value, exam.label)
          );
        });
        if (!optionsByValue.size) {
          fallbackTermOptions.forEach((period) => optionsByValue.set(period.value, period.label));
        }

        periodSelect.innerHTML = "";
        optionsByValue.forEach((label, value) => {
          const option = document.createElement("option");
          option.value = value;
          option.textContent = translate(label);
          periodSelect.appendChild(option);
        });
      }

      document.querySelectorAll(".class-choice").forEach((input) => {
        input.addEventListener("change", renderPeriodOptions);
      });
      renderPeriodOptions();

      function addSubjectLine() {
        const container = document.getElementById("subjectsContainer");
        const newLine = document.createElement("div");
        newLine.className = "grid grid-cols-3 gap-2 items-center mt-2";
        newLine.innerHTML = `
                <select name="subjects[${subjectIndex}][subjectId]" class="subject-select px-2 py-1 border rounded text-sm">
                  <option value="">Sélectionner matière</option>
                  @each(subject in subjects)
        <option value="{{ subject.id }}">
          {{ subject.name }}
        </option>
      @end



                </select>
                <input type="date" name="subjects[${subjectIndex}][examDate]" placeholder="Date" class="px-2 py-1 border rounded text-sm">
                <input type="text" name="subjects[${subjectIndex}][duration]" placeholder="Durée (h)" class="px-2 py-1 border rounded text-sm w-24">
                <button type="button" onclick="removeSubjectLine(this)" class="text-red-500">✕</button>
              `;
        container.appendChild(newLine);
        subjectIndex++;
      }

      function removeSubjectLine(btn) {
        btn.parentElement.remove();
      }
      // Validation des dates

      const startDateInput = document.querySelector('input[name="startDate"]');

      const endDateInput = document.querySelector('input[name="endDate"]');

      startDateInput.addEventListener("change", () => {
        endDateInput.min = startDateInput.value;
      });
      // Dates par défaut

      const today = new Date();

      startDateInput.value = today.toISOString().split("T")[0];

      const nextWeek = new Date(today);

      nextWeek.setDate(today.getDate() + 7);

      endDateInput.value = nextWeek.toISOString().split("T")[0];
    </script>
  @endsection
  
