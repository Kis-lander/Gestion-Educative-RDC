    <script>
      const classEvaluationPolicies = {{ classEvaluationPolicies|json_encode|raw }};
      const fallbackTermOptions = {{ fallbackTermOptions|json_encode|raw }};
      const fallbackEvaluationTypeOptions = {{ fallbackEvaluationTypeOptions|json_encode|raw }};
      const selectedTerm = "{{ term }}";
      const selectedExamType = "{{ examType || '' }}";
      const translate = (text) => window.AppTranslations?.translate(text) || text;
      const classPolicy = classEvaluationPolicies["{{ classId }}"] || Object.values(classEvaluationPolicies)[0] || {
        periods: fallbackTermOptions,
        evaluationTypes: fallbackEvaluationTypeOptions
      };
      const termFilter = document.getElementById("termFilter");
      const examTypeFilter = document.getElementById("examTypeFilter");

      function renderPolicyFilters() {
        termFilter.innerHTML = "";
        const periods = classPolicy.periods?.length ? classPolicy.periods : fallbackTermOptions;
        const evaluationTypes = classPolicy.evaluationTypes?.length ? classPolicy.evaluationTypes : fallbackEvaluationTypeOptions;
        periods.forEach((period) => {
          const option = document.createElement("option");
          option.value = period.value;
          option.textContent = translate(period.label);
          termFilter.appendChild(option);
        });
        termFilter.value = selectedTerm && periods.some((period) => period.value === selectedTerm)
          ? selectedTerm
          : periods[0]?.value || "";

        evaluationTypes.forEach((type) => {
          const option = document.createElement("option");
          option.value = type.value;
          option.textContent = translate(type.label);
          examTypeFilter.appendChild(option);
        });
        examTypeFilter.value = selectedExamType;
      }

      function changeSubject() {
        const subjectId = document.getElementById("subjectFilter").value;
        const term = document.getElementById("termFilter").value;
        window.location.href = `/academic/grades/class/{{ classId }}?subject_id=${subjectId}&term=${term}`;
      }

      function changeTerm() {
        const subjectId = document.getElementById("subjectFilter").value;
        const term = document.getElementById("termFilter").value;
        window.location.href = `/academic/grades/class/{{ classId }}?subject_id=${subjectId}&term=${term}`;
      }

      function changeExamType() {
        const examType = document.getElementById("examTypeFilter").value;
        // Recharger avec le type d'examen
      }

      function exportGrades() {
        const subjectId = document.getElementById("subjectFilter").value;
        const term = document.getElementById("termFilter").value;
        window.location.href = `/api/grades/class/{{ classId }}/export?subject_id=${subjectId}&term=${term}`;
      }

      renderPolicyFilters();
    </script>
  @endsection
  
