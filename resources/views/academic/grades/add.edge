    Saisie des évaluations - {{ school.name }}
  @endsection

  @section('dashboardTitle')
    Saisie des évaluations
  @endsection
  @section('dashboardSubtitle')
    Harmonisez les observations, travaux et examens selon la section.
  @endsection

  @section('content')
    <div class="rounded-xl bg-white p-6 shadow-md dark:bg-gray-800">
      <div class="mb-6 grid grid-cols-1 gap-4 md:grid-cols-6">
        <div>
          <label class="mb-2 block text-gray-700 dark:text-gray-300" data-i18n>Classe *</label>
          <select id="classSelect" class="w-full rounded-lg border px-3 py-2">
            <option value="" data-i18n>Sélectionner</option>
            @each(classObj in classes)
              <option
                value="{{ classObj.id }}"
                data-policy-key="{{ classEvaluationPolicies[classObj.id]?.section || 'secondaire' }}"
                {{ selectedClassId === classObj.id ? 'selected' : '' }}
              >
                {{ classObj.name }}
              </option>
            @end
          </select>
        </div>
        <div>
          <label class="mb-2 block text-gray-700 dark:text-gray-300" data-i18n>Matière *</label>
          <select id="subjectSelect" class="w-full rounded-lg border px-3 py-2" disabled>
            <option value="" data-i18n>Sélectionnez d'abord une classe</option>
          </select>
        </div>
        <div>
          <label id="termLabel" class="mb-2 block text-gray-700 dark:text-gray-300" data-i18n>Période scolaire *</label>
          <select id="termSelect" class="w-full rounded-lg border px-3 py-2"></select>
        </div>
        <div>
          <label class="mb-2 block text-gray-700 dark:text-gray-300" data-i18n>Type d'évaluation *</label>
          <select id="examTypeSelect" class="w-full rounded-lg border px-3 py-2"></select>
        </div>
        <div>
          <label id="examDateLabel" class="mb-2 block text-gray-700 dark:text-gray-300" data-i18n>Date de l'évaluation *</label>
          <input type="date" id="examDate" class="w-full rounded-lg border px-3 py-2" />
        </div>
        <div>
          <label class="mb-2 block text-gray-700 dark:text-gray-300" data-i18n>Pondération *</label>
          <input type="number" id="maxScoreInput" min="1" max="500" step="0.5" value="20" class="w-full rounded-lg border px-3 py-2" />
        </div>
      </div>

      <div id="gradesGrid" class="mt-4">
        <div class="py-8 text-center text-gray-500">
          <i class="fas fa-arrow-left mb-2 block text-2xl"></i>
          <span data-i18n>Sélectionnez une classe et une matière pour commencer.</span>
        </div>
      </div>

      <div class="mt-6 hidden gap-3 border-t pt-4" id="actionButtons">
        <button id="saveGrades" class="rounded-lg bg-primary px-6 py-2 text-white hover:bg-blue-700">
          <i class="fas fa-save mr-2"></i><span data-i18n>Enregistrer</span>
        </button>
        <button id="saveAndPublish" class="rounded-lg bg-green-600 px-6 py-2 text-white hover:bg-green-700">
          <i class="fas fa-check-circle mr-2"></i><span data-i18n>Enregistrer et publier</span>
        </button>
      </div>
    </div>

    <script>
      const evaluationPolicies = {
        maternelle: {
          periodAxisLabel: "Période scolaire",
          dateLabel: "Date d'observation",
          scoreLabel: "Appréciation",
          scoreRequired: false,
          periods: [["T1-P1", "Trimestre 1 - Période 1"], ["T1-P2", "Trimestre 1 - Période 2"], ["T2-P1", "Trimestre 2 - Période 1"], ["T2-P2", "Trimestre 2 - Période 2"], ["T3-P1", "Trimestre 3 - Période 1"], ["T3-P2", "Trimestre 3 - Période 2"]],
          evaluationTypes: [["Observation", "Observation"], ["Appréciation", "Appréciation"], ["Activité pratique", "Activité pratique"]],
        },
        primaire: {
          periodAxisLabel: "Période scolaire",
          dateLabel: "Date de l'évaluation",
          scoreLabel: "Note",
          scoreRequired: true,
          periods: [["T1-P1", "Trimestre 1 - Période 1"], ["T1-P2", "Trimestre 1 - Période 2"], ["T1-EX", "Trimestre 1 - Examen trimestriel"], ["T2-P1", "Trimestre 2 - Période 1"], ["T2-P2", "Trimestre 2 - Période 2"], ["T2-EX", "Trimestre 2 - Examen trimestriel"], ["T3-P1", "Trimestre 3 - Période 1"], ["T3-P2", "Trimestre 3 - Période 2"], ["T3-EX", "Trimestre 3 - Examen trimestriel"]],
          evaluationTypes: [["Travail journalier", "Travail journalier"], ["Interrogation", "Interrogation"], ["Devoir", "Devoir"], ["Examen trimestriel", "Examen trimestriel"]],
        },
        secondaire: {
          periodAxisLabel: "Période scolaire",
          dateLabel: "Date de l'évaluation",
          scoreLabel: "Note",
          scoreRequired: true,
          periods: [["S1-P1", "Semestre 1 - Période 1"], ["S1-P2", "Semestre 1 - Période 2"], ["S1-EX", "Semestre 1 - Examen semestriel"], ["S2-P1", "Semestre 2 - Période 1"], ["S2-P2", "Semestre 2 - Période 2"], ["S2-EX", "Semestre 2 - Examen semestriel"]],
          evaluationTypes: [["Travail journalier", "Travail journalier"], ["Interrogation", "Interrogation"], ["Devoir", "Devoir"], ["Examen semestriel", "Examen semestriel"]],
        },
      };

      const normalizedEvaluationPolicies = {{ evaluationPolicies|json_encode|raw }};
      const classEvaluationPolicies = {{ classEvaluationPolicies|json_encode|raw }};
      const fallbackTermOptions = {{ fallbackTermOptions|json_encode|raw }};
      const fallbackEvaluationTypeOptions = {{ fallbackEvaluationTypeOptions|json_encode|raw }};

      const classSelect = document.getElementById("classSelect");
      const subjectSelect = document.getElementById("subjectSelect");
      const termSelect = document.getElementById("termSelect");
      const examTypeSelect = document.getElementById("examTypeSelect");
      const examDate = document.getElementById("examDate");
      const maxScoreInput = document.getElementById("maxScoreInput");
      const gradesGrid = document.getElementById("gradesGrid");
      const actionButtons = document.getElementById("actionButtons");
      let studentsList = [];
      let existingGrades = {};
      let subjectId = null;

      const translate = (text) => window.AppTranslations?.translate(text) || text;
      const selectedPolicy = () =>
        classEvaluationPolicies[classSelect.value] ||
        normalizedEvaluationPolicies[classSelect.selectedOptions[0]?.dataset.policyKey] ||
        normalizedEvaluationPolicies.secondaire || {
          periods: fallbackTermOptions,
          evaluationTypes: fallbackEvaluationTypeOptions,
          dateLabel: "Date de l'évaluation"
        };

      const choiceValue = (choice) => Array.isArray(choice) ? choice[0] : choice.value;
      const choiceLabel = (choice) => Array.isArray(choice) ? choice[1] : choice.label;
      function renderEvaluationPolicy() {
        const policy = selectedPolicy();
        document.getElementById("termLabel").textContent = `${translate("Période scolaire")} *`;
        document.getElementById("examDateLabel").textContent = `${translate(policy.dateLabel)} *`;
        const periods = policy.periods?.length ? policy.periods : fallbackTermOptions;
        const evaluationTypes = policy.evaluationTypes?.length ? policy.evaluationTypes : fallbackEvaluationTypeOptions;
        termSelect.innerHTML = periods.map((period) => `<option value="${choiceValue(period)}">${translate(choiceLabel(period))}</option>`).join("");
        examTypeSelect.innerHTML = evaluationTypes.map((type) => `<option value="${choiceValue(type)}">${translate(choiceLabel(type))}</option>`).join("");
      }

      async function loadSubjects() {
        renderEvaluationPolicy();
        const classId = classSelect.value;
        if (!classId) return;
        const res = await fetch(`/api/classes/${classId}/subjects`);
        const data = await res.json();
        subjectSelect.innerHTML = `<option value="">${translate("Sélectionner une matière")}</option>`;
        if (data.subjects && data.subjects.length > 0) {
          data.subjects.forEach((subject) => {
            subjectSelect.innerHTML += `<option value="${subject.subject_id}">${subject.subject_name}</option>`;
          });
          subjectSelect.disabled = false;
        } else {
          subjectSelect.innerHTML = `<option value="">${translate("Aucune matière assignée")}</option>`;
          subjectSelect.disabled = true;
        }
      }

      async function loadStudentsAndGrades() {
        const classId = classSelect.value;
        subjectId = subjectSelect.value;
        const term = termSelect.value;
        const examType = encodeURIComponent(examTypeSelect.value);
        if (!classId || !subjectId) return;
        const studentsRes = await fetch(`/api/classes/${classId}/students`);
        const studentsData = await studentsRes.json();
        studentsList = studentsData.students || [];
        const gradesRes = await fetch(`/api/grades/class/${classId}?subject_id=${subjectId}&term=${term}&exam_type=${examType}`);
        const gradesData = await gradesRes.json();
        existingGrades = {};
        if (gradesData.gradesByStudent) {
          gradesData.gradesByStudent.forEach((student) => {
            student.grades.forEach((grade) => {
              existingGrades[grade.studentId] = grade;
            });
          });
        }
        renderGradesForm();
        actionButtons.classList.remove("hidden");
        actionButtons.classList.add("flex");
      }

      function renderGradesForm() {
        const policy = selectedPolicy();
        const maxScore = Number(maxScoreInput.value) || policy.defaultMaxScore || 20;
        if (!studentsList.length) {
          gradesGrid.innerHTML = `<div class="py-8 text-center text-gray-500">${translate("Aucun élève dans cette classe.")}</div>`;
          return;
        }
        let html = `<div class="table-responsive"><table class="w-full"><thead class="bg-gray-50 dark:bg-gray-700"><tr><th class="px-4 py-3 text-left">${translate("Matricule")}</th><th class="px-4 py-3 text-left">${translate("Élève")}</th><th class="px-4 py-3 text-center">${translate("Note")} /${maxScore}</th><th class="px-4 py-3 text-left">${translate("Appréciation")}</th></tr></thead><tbody>`;
        studentsList.forEach((student) => {
          const existingGrade = existingGrades[student.id];
          const noteValue = existingGrade && existingGrade.score !== null ? existingGrade.score : "";
          const commentValue = existingGrade ? existingGrade.teacherComments || "" : "";
          html += `<tr><td class="px-4 py-3 font-mono text-sm">${student.registrationNumber}</td><td class="px-4 py-3 font-medium">${student.user.fullName}</td><td class="px-4 py-3 text-center"><input type="number" step="0.5" min="0" max="${maxScore}" class="grade-input w-24 rounded border px-2 py-1 text-center" data-student-id="${student.id}" value="${noteValue}" placeholder="${policy.scoreRequired ? `0-${maxScore}` : translate("Optionnel")}"></td><td class="px-4 py-3"><input type="text" class="comment-input w-full rounded border px-2 py-1 text-sm" data-student-id="${student.id}" value="${escapeHtml(commentValue)}" placeholder="${translate("Appréciation (optionnel)")}"></td></tr>`;
        });
        gradesGrid.innerHTML = `${html}</tbody></table></div>`;
      }

      function escapeHtml(text) {
        const div = document.createElement("div");
        div.textContent = text;
        return div.innerHTML;
      }

      async function saveGrades(publish = false) {
        const classId = classSelect.value;
        const term = termSelect.value;
        const examType = examTypeSelect.value;
        const date = examDate.value;
        const policy = selectedPolicy();
        const maxScore = Number(maxScoreInput.value);
        if (!classId || !subjectId) return alert(translate("Veuillez sélectionner une classe et une matière."));
        if (!date) return alert(translate("Veuillez sélectionner une date d'évaluation."));
        if (!Number.isFinite(maxScore) || maxScore <= 0 || maxScore > 500) return alert(translate("Veuillez saisir une pondération entre 1 et 500."));
        const grades = [];
        document.querySelectorAll(".grade-input").forEach((input) => {
          const studentId = input.dataset.studentId;
          const score = parseFloat(input.value);
          const comment = document.querySelector(`.comment-input[data-student-id="${studentId}"]`)?.value || "";
          if ((!isNaN(score) && score >= 0 && score <= maxScore) || (!policy.scoreRequired && comment.trim())) {
            grades.push({ studentId, score: isNaN(score) ? 0 : score, comment });
          }
        });
        if (!grades.length) return alert(translate("Aucune évaluation valide à enregistrer."));

        let successCount = 0;
        for (const grade of grades) {
          const res = await fetch("/academic/grades", {
            method: "POST",
            headers: { "Content-Type": "application/json", "X-CSRF-TOKEN": "{{ csrfToken }}" },
            body: JSON.stringify({ studentId: grade.studentId, subjectId, classId, term, examType, score: grade.score, maxScore, teacherComments: grade.comment, examDate: date }),
          });
          const data = await res.json();
          if (data.success) successCount++;
        }
        if (publish) {
          await fetch("/academic/grades/publish", {
            method: "POST",
            headers: { "Content-Type": "application/json", "X-CSRF-TOKEN": "{{ csrfToken }}" },
            body: JSON.stringify({ classId, term, notifyParents: true }),
          });
        }
        alert(translate(publish ? "Évaluations enregistrées et publiées avec succès." : "Évaluations enregistrées avec succès.").replace("Évaluations", `${successCount} évaluation(s)`));
        await loadStudentsAndGrades();
      }

      classSelect.addEventListener("change", loadSubjects);
      subjectSelect.addEventListener("change", loadStudentsAndGrades);
      termSelect.addEventListener("change", () => subjectId && loadStudentsAndGrades());
      examTypeSelect.addEventListener("change", () => {
        if (subjectId) loadStudentsAndGrades();
        else renderGradesForm();
      });
      maxScoreInput.addEventListener("change", renderGradesForm);
      document.getElementById("saveGrades")?.addEventListener("click", () => saveGrades(false));
      document.getElementById("saveAndPublish")?.addEventListener("click", () => saveGrades(true));
      renderEvaluationPolicy();
      if (classSelect.value) loadSubjects();
      examDate.value = new Date().toISOString().split("T")[0];
    </script>
  @endsection
