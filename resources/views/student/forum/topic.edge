              name="content"
              rows="3"
              class="w-full resize-none rounded-2xl border border-gray-200 bg-gray-100 px-4 py-3 text-sm focus:ring-2 focus:ring-primary dark:border-gray-700 dark:bg-gray-800"
              placeholder="Rédigez votre réponse ici..."
