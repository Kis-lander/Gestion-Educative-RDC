    </div>
    
    <script>
      const fileInput = document.getElementById("fileInput");

      const fileName = document.getElementById("fileName");

      fileInput?.addEventListener("change", function() {
        if (this.files && this.files[0]) {
          const selectedLabel = window.AppTranslations?.translate("Fichier sélectionné") || "Fichier sélectionné";
          fileName.textContent = `${selectedLabel}: ${this.files[0].name}`;
          fileName.classList.remove("hidden");
        }
      });

      function setReplyTarget(author, content, postId, topicId) {
        document.getElementById("parentPostId").value = postId || "";
        document.getElementById("parentTopicId").value = topicId || "";
        const preview = document.getElementById("replyTargetPreview");
        preview.innerHTML = `
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <p class="font-semibold">Réponse à ${escapeHtml(author)}</p>
              <p class="truncate opacity-80">${escapeHtml(content || "Fichier joint")}</p>
            </div>
            <button type="button" onclick="clearReplyTarget()" class="rounded px-2 py-1 hover:bg-blue-100 dark:hover:bg-blue-800">
              <i class="fas fa-times"></i>
            </button>
          </div>
        `;
        preview.classList.remove("hidden");
        document.querySelector('textarea[name="content"]').focus();
      }

      function clearReplyTarget() {
        document.getElementById("parentPostId").value = "";
        document.getElementById("parentTopicId").value = "";
        const preview = document.getElementById("replyTargetPreview");
        preview.classList.add("hidden");
        preview.innerHTML = "";
      }

      function replyToTopic() {
        setReplyTarget("{{ topic.authorName }}", document.getElementById("topicContent")?.textContent?.trim() || "", "", "{{ topic.id }}");
      }

      function getReplyData(id) {
        const node = document.querySelector(`[data-reply-id="${id}"]`);
        return {
          author: node?.querySelector("[data-reply-author]")?.textContent?.trim() || "Auteur",
          content: node?.querySelector("[data-reply-content]")?.textContent?.trim() || ""
        };
      }

      function replyToPost(id) {
        const data = getReplyData(id);
        setReplyTarget(data.author, data.content, id, "");
      }

      function getTopicTitle() {
        return document.querySelector("[data-page-header] h1")?.textContent?.trim() || "{{ topic.title }}";
      }

      function getTopicContent() {
        return document.getElementById("topicContent")?.textContent?.trim() || "";
      }

      function replyToPostLegacy(id, author, content) {
        setReplyTarget(author, content, id, "");
      }

      async function editTopic() {
        const content = prompt("Modifier votre message", getTopicContent());
        if (content === null) return;
        const res = await fetch("/student/forum/topic/{{ topic.id }}", {
          method: "PUT",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-TOKEN": "{{ csrfToken }}"
          },
          body: JSON.stringify({ content })
        });
        const data = await res.json();
        if (data.success) location.reload(); else alert("Erreur: " + data.message);
      }

      async function editReply(replyId) {
        const content = prompt("Modifier votre message", getReplyData(replyId).content);
        if (content === null) return;
        const res = await fetch(`/student/forum/reply/${replyId}`, {
          method: "PUT",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-TOKEN": "{{ csrfToken }}"
          },
          body: JSON.stringify({ content })
        });
        const data = await res.json();
        if (data.success) location.reload(); else alert("Erreur: " + data.message);
      }

      function escapeHtml(text) {
        const div = document.createElement("div");
        div.textContent = text || "";
        return div.innerHTML;
      }

      function scrollToReply() {
        document.getElementById("replyForm").scrollIntoView({
          behavior: "smooth"
        });
      }

      function deleteTopic() {
        if (confirm("Supprimer définitivement ce sujet ? Toutes les réponses seront également supprimées.")) {
          fetch("/student/forum/topic/{{ topic.id }}", {
            method: "DELETE",
            headers: {
              "X-CSRF-TOKEN": "{{ csrfToken }}"
            }
          }).then(res => res.json()).then(data => {
            if (data.success) window.location.href = "/student/forum"; else alert("Erreur: " + data.message);
          });
        }
      }

      function deleteReply(replyId) {
        if (confirm("Supprimer cette réponse ?")) {
          fetch(`/student/forum/reply/${replyId}`, {
            method: "DELETE",
            headers: {
              "X-CSRF-TOKEN": "{{ csrfToken }}"
            }
          }).then(res => res.json()).then(data => {
            if (data.success) location.reload(); else alert("Erreur: " + data.message);
          });
        }
      }
      // Incrémenter le compteur de vues

      fetch("/api/student/forum/topic/{{ topic.id }}/view", {
        method: "POST"
      });
    </script>
  @endsection
  
