    <!-- Formulaire de réponse -->
    @if(!topic.isLocked)
      <div id="replyForm" class="border-t border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-gray-900">
        <form
          method="POST"
          action="/student/forum/topic/{{ topic.id }}/reply"
          enctype="multipart/form-data"
          x-data="{ loading: false }"
          @submit="loading = true"
        >
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          <input type="hidden" name="parentPostId" id="parentPostId" />
          <input type="hidden" name="parentTopicId" id="parentTopicId" />
          <div id="replyTargetPreview" class="hidden mb-4 rounded-lg border-l-4 border-primary bg-blue-50 p-3 text-sm text-blue-900 dark:bg-blue-900/20 dark:text-blue-100"></div>

          <div class="mb-3">
