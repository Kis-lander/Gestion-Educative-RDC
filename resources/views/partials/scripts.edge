<!-- Alpine.js pour l'interactivité -->
<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js">

</script>

<script>
  (() => {
    const nativeFetch = window.fetch.bind(window);

    window.fetch = async (...args) => {
      const response = await nativeFetch(...args);
      const contentType = response.headers.get('content-type') || '';

      if (contentType.includes('application/json')) {
        const payload = await response.clone().json().catch(() => null);
        if (payload?.success === true && payload.message) {
          window.dispatchEvent(new CustomEvent('show-toast', {
            detail: { message: payload.message, type: 'success' },
          }));
        }
      }

      return response;
    };
  })();

  (() => {
    const styleId = "global-scroll-effects";

    if (!document.getElementById(styleId)) {
      const style = document.createElement("style");
      style.id = styleId;
      style.textContent = `
        html { scroll-behavior: smooth; }

        @media (prefers-reduced-motion: no-preference) {
          .scroll-reveal {
            opacity: 0;
            transform: translateY(44px) scale(0.98);
            transition:
              opacity 1.12s cubic-bezier(0.16, 1, 0.3, 1),
              transform 1.12s cubic-bezier(0.16, 1, 0.3, 1);
            transition-delay: var(--reveal-delay, 0ms);
            will-change: opacity, transform;
          }

          .scroll-reveal.is-visible {
            opacity: 1;
            transform: translateY(0) scale(1);
          }
        }

        .scroll-top-button {
          position: fixed;
          right: 22px;
          bottom: 22px;
          z-index: 70;
          display: inline-flex;
          align-items: center;
          justify-content: center;
          width: 48px;
          height: 48px;
          border: 1px solid rgba(255, 255, 255, 0.42);
          border-radius: 9999px;
          background: rgba(29, 78, 216, 0.94);
          color: #fff;
          box-shadow: 0 16px 36px rgba(15, 23, 42, 0.28);
          opacity: 0;
          pointer-events: none;
          transform: translateY(14px);
          transition:
            opacity 0.22s ease,
            transform 0.22s ease,
            background-color 0.18s ease;
        }

        .scroll-top-button.is-visible {
          opacity: 1;
          pointer-events: auto;
          transform: translateY(0);
        }

        .scroll-top-button:hover {
          background: #1e40af;
        }
      `;
      document.head.appendChild(style);
    }

    const initScrollEffects = () => {
      const revealSelector = [
        "main > div > *",
        ".card-hover",
        ".bg-white.rounded-lg",
        ".bg-white.rounded-xl",
        ".dark\\:bg-gray-800.rounded-lg",
        ".dark\\:bg-gray-800.rounded-xl"
      ].join(",");

      const revealItems = Array.from(document.querySelectorAll(revealSelector))
        .filter((item) =>
          !item.closest("[x-cloak]") &&
          !item.closest("[data-no-scroll-reveal]") &&
          !item.classList.contains("scroll-top-button")
        );

      revealItems.forEach((item, index) => {
        item.classList.add("scroll-reveal");
        item.style.setProperty("--reveal-delay", `${Math.min(index % 6, 5) * 80}ms`);
      });

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.14,
          rootMargin: "0px 0px -70px 0px"
        });

        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      }

      let scrollButton = document.querySelector(".scroll-top-button");
      if (!scrollButton) {
        scrollButton = document.createElement("button");
        scrollButton.type = "button";
        scrollButton.className = "scroll-top-button";
        scrollButton.setAttribute("aria-label", "Remonter au debut de la page");
        scrollButton.innerHTML = '<i class="fas fa-arrow-up" aria-hidden="true"></i>';
        document.body.appendChild(scrollButton);
      }

      const toggleScrollButton = () => {
        scrollButton.classList.toggle("is-visible", window.scrollY > 360);
      };

      scrollButton.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });

      toggleScrollButton();
      window.addEventListener("scroll", toggleScrollButton, { passive: true });
    };

    const provincesRdc = [
      "Bas-Uele",
      "Équateur",
      "Haut-Katanga",
      "Haut-Lomami",
      "Haut-Uele",
      "Ituri",
      "Kasaï",
      "Kasaï-Central",
      "Kasaï-Oriental",
      "Kinshasa",
      "Kongo Central",
      "Kwango",
      "Kwilu",
      "Lomami",
      "Lualaba",
      "Mai-Ndombe",
      "Maniema",
      "Mongala",
      "Nord-Kivu",
      "Nord-Ubangi",
      "Sankuru",
      "Sud-Kivu",
      "Sud-Ubangi",
      "Tanganyika",
      "Tshopo",
      "Tshuapa"
    ];

    const territoriesByProvince = {
      "Bas-Uele": ["Aketi", "Ango", "Bambesa", "Bondo", "Buta", "Poko"],
      "Equateur": ["Basankusu", "Bikoro", "Bolomba", "Bomongo", "Ingende", "Lukolela", "Makanza", "Mbandaka"],
      "Équateur": ["Basankusu", "Bikoro", "Bolomba", "Bomongo", "Ingende", "Lukolela", "Makanza", "Mbandaka"],
      "Haut-Katanga": ["Kambove", "Kasenga", "Kipushi", "Likasi", "Lubumbashi", "Mitwaba", "Pweto", "Sakania"],
      "Haut-Lomami": ["Bukama", "Kabongo", "Kamina", "Kaniama", "Malemba-Nkulu"],
      "Haut-Uele": ["Dungu", "Faradje", "Isiro", "Niangara", "Rungu", "Wamba", "Watsa"],
      "Ituri": ["Aru", "Bunia", "Djugu", "Irumu", "Mahagi", "Mambasa"],
      "Kasaï": ["Dekese", "Ilebo", "Kamonia", "Luebo", "Mweka", "Tshikapa"],
      "Kasai": ["Dekese", "Ilebo", "Kamonia", "Luebo", "Mweka", "Tshikapa"],
      "Kasaï-Central": ["Demba", "Dibaya", "Dimbelenge", "Kananga", "Kazumba", "Luiza"],
      "Kasai-Central": ["Demba", "Dibaya", "Dimbelenge", "Kananga", "Kazumba", "Luiza"],
      "Kasaï-Oriental": ["Kabeya-Kamwanga", "Katanda", "Lupatapata", "Miabi", "Mbuji-Mayi", "Tshilenge"],
      "Kasai-Oriental": ["Kabeya-Kamwanga", "Katanda", "Lupatapata", "Miabi", "Mbuji-Mayi", "Tshilenge"],
      "Kinshasa": [
        "Bandalungwa",
        "Barumbu",
        "Bumbu",
        "Gombe",
        "Kalamu",
        "Kasa-Vubu",
        "Kimbanseke",
        "Kinshasa",
        "Kintambo",
        "Kisenso",
        "Lemba",
        "Limete",
        "Lingwala",
        "Makala",
        "Maluku",
        "Masina",
        "Matete",
        "Mont-Ngafula",
        "Ndjili",
        "Ngaba",
        "Ngaliema",
        "Ngiri-Ngiri",
        "Nsele",
        "Selembao"
      ],
      "Kongo Central": ["Boma", "Kasangulu", "Kimvula", "Lukula", "Luozi", "Madimba", "Matadi", "Mbanza-Ngungu", "Moanda", "Seke-Banza", "Songololo", "Tshela"],
      "Kwango": ["Feshi", "Kahemba", "Kasongo-Lunda", "Kenge", "Popokabaka"],
      "Kwilu": ["Bagata", "Bandundu", "Bulungu", "Gungu", "Idiofa", "Kikwit", "Masi-Manimba"],
      "Lomami": ["Kabinda", "Kamiji", "Lubao", "Luilu", "Ngandajika"],
      "Lualaba": ["Dilolo", "Kapanga", "Kolwezi", "Lubudi", "Mutshatsha", "Sandoa"],
      "Mai-Ndombe": ["Bolobo", "Inongo", "Kiri", "Kutu", "Kwamouth", "Mushie", "Oshwe", "Yumbi"],
      "Maniema": ["Kabambare", "Kailo", "Kasongo", "Kibombo", "Kindu", "Lubutu", "Pangi", "Punia"],
      "Mongala": ["Bongandanga", "Bumba", "Lisala"],
      "Nord-Kivu": ["Beni", "Butembo", "Goma", "Lubero", "Masisi", "Nyiragongo", "Rutshuru", "Walikale"],
      "Nord-Ubangi": ["Bosobolo", "Businga", "Gbadolite", "Mobayi-Mbongo", "Yakoma"],
      "Sankuru": ["Katako-Kombe", "Kole", "Lodja", "Lomela", "Lubefu", "Lusambo"],
      "Sud-Kivu": ["Bukavu", "Fizi", "Idjwi", "Kabare", "Kalehe", "Mwenga", "Shabunda", "Uvira", "Walungu"],
      "Sud-Ubangi": ["Budjala", "Gemena", "Kungu", "Libenge", "Zongo"],
      "Tanganyika": ["Kabalo", "Kalemie", "Kongolo", "Manono", "Moba", "Nyunzu"],
      "Tshopo": ["Bafwasende", "Banalia", "Basoko", "Isangi", "Kisangani", "Opala", "Ubundu", "Yahuma"],
      "Tshuapa": ["Befale", "Boende", "Bokungu", "Djolu", "Ikela", "Monkoto"]
    };

    const getTerritoriesForProvince = (province) => {
      return territoriesByProvince[province] || [];
    };

    const initProvinceSelects = () => {
      const selectors = [
        'select[name="province"]',
        'select[name="targetProvince"]',
        'select[id="filterProvince"]',
        'select[id="province"]'
      ].join(",");

      document.querySelectorAll(selectors).forEach((select) => {
        const selectedValue = select.value;
        const firstOption = select.querySelector("option");
        const placeholder =
          firstOption && firstOption.value === ""
            ? { value: "", text: firstOption.textContent.trim() || "Toutes" }
            : null;

        select.innerHTML = "";

        if (placeholder) {
          const option = document.createElement("option");
          option.value = placeholder.value;
          option.textContent = placeholder.text;
          select.appendChild(option);
        }

        if (selectedValue && !provincesRdc.includes(selectedValue)) {
          const option = document.createElement("option");
          option.value = selectedValue;
          option.textContent = selectedValue;
          select.appendChild(option);
        }

        provincesRdc.forEach((province) => {
          const option = document.createElement("option");
          option.value = province;
          option.textContent = province;
          select.appendChild(option);
        });

        select.value = selectedValue || "";
      });
    };

    const initTerritorySelects = () => {
      document.querySelectorAll('select[name="territory"]').forEach((select) => {
        const form = select.closest("form") || document;
        const provinceSelect = form.querySelector('select[name="province"]');

        if (!provinceSelect) return;

        const selectedValue = select.dataset.selected || select.value;

        const renderOptions = () => {
          const province = provinceSelect.value;
          const territories = getTerritoriesForProvince(province);
          const currentValue = select.value || selectedValue;

          select.innerHTML = "";

          const placeholder = document.createElement("option");
          placeholder.value = "";
          placeholder.textContent = province
            ? "Sélectionner un territoire / une commune"
            : "Choisir d'abord une province";
          select.appendChild(placeholder);

          territories.forEach((territory) => {
            const option = document.createElement("option");
            option.value = territory;
            option.textContent = territory;
            select.appendChild(option);
          });

          select.disabled = !province || territories.length === 0;
          select.value = territories.includes(currentValue) ? currentValue : "";
          select.dataset.selected = select.value;
        };

        provinceSelect.addEventListener("change", () => {
          select.dataset.selected = "";
          renderOptions();
        });

        renderOptions();
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => {
        initProvinceSelects();
        initTerritorySelects();
        initScrollEffects();
      }, { once: true });
    } else {
      initProvinceSelects();
      initTerritorySelects();
      initScrollEffects();
    }
  })();

  // Store global Alpine
  document.addEventListener("alpine:init", () => {
    Alpine.store("loading", {
      loading: false
    });
    Alpine.store("toast", {
      show(message, type = "success") {
        const toastEvent = new CustomEvent("show-toast", {
          detail: {
            message: message,
            type: type
          }
        });
        window.dispatchEvent(toastEvent);
      }
    });
  });
  // Fonctions utilitaires

  function getInterfaceLocale() {
    return document.documentElement.lang === "en" ? "en-US" : "fr-FR";
  }

  function formatDate(date) {
    if (!date) return "-";
    return new Date(date).toLocaleDateString(getInterfaceLocale(), {
      day: "2-digit",
      month: "2-digit",
      year: "numeric"
    });
  }

  function formatDateTime(date) {
    if (!date) return "-";
    return new Date(date).toLocaleDateString(getInterfaceLocale(), {
      day: "2-digit",
      month: "2-digit",
      year: "numeric",
      hour: "2-digit",
      minute: "2-digit"
    });
  }

  function formatCurrency(amount, currency = "USD") {
    if (!amount && amount !== 0) return "-";
    return new Intl.NumberFormat(getInterfaceLocale(), {
      style: "currency",
      currency: currency,
      minimumFractionDigits: 0,
      maximumFractionDigits: 0
    }).format(amount);
  }

  function formatPercentage(value) {
    if (!value && value !== 0) return "-";
    return `${Math.round(value)}%`;
  }

  function truncateText(text, maxLength = 50) {
    if (!text) return "";
    if (text.length <= maxLength) return text;
    return text.substring(0, maxLength) + "...";
  }
  // Gestion globale des messages d'action

  window.showToastFn = null;

  (() => {
    const defaultMessages = {
      success: "Opération effectuée avec succès.",
      error: "L'action n'a pas pu être exécutée. Vérifiez les informations puis réessayez.",
      warning: "Veuillez vérifier les informations saisies.",
      info: "Information enregistrée."
    };

    const typeClasses = {
      success: "bg-green-600",
      error: "bg-red-600",
      warning: "bg-yellow-500",
      info: "bg-blue-600"
    };

    const icons = {
      success: "fas fa-check-circle",
      error: "fas fa-exclamation-circle",
      warning: "fas fa-exclamation-triangle",
      info: "fas fa-info-circle"
    };

    const normalizeType = (type) => ["success", "error", "warning", "info"].includes(type) ? type : "info";

    const createToastContainer = () => {
      let container = document.getElementById("global-toast-container");
      if (container) return container;

      container = document.createElement("div");
      container.id = "global-toast-container";
      container.className =
        "fixed inset-x-3 bottom-4 z-[9999] flex flex-col gap-3 sm:left-auto sm:right-4 sm:w-[min(92vw,420px)]";
      container.setAttribute("aria-live", "polite");
      container.setAttribute("aria-atomic", "true");
      document.body.appendChild(container);
      return container;
    };

    const getMessageFromPayload = (payload, fallback) => {
      if (!payload || typeof payload !== "object") return fallback;
      if (typeof payload.message === "string" && payload.message.trim()) return payload.message.trim();
      if (typeof payload.error === "string" && payload.error.trim()) return payload.error.trim();
      if (payload.errors && typeof payload.errors === "object") {
        const firstError = Array.isArray(payload.errors)
          ? payload.errors[0]
          : Object.values(payload.errors)[0];
        if (typeof firstError === "string" && firstError.trim()) return firstError.trim();
        if (Array.isArray(firstError) && firstError[0]) return String(firstError[0]);
        if (firstError?.message) return String(firstError.message);
      }
      return fallback;
    };

    const translateFeedback = (message) => {
      const text = String(message || "");
      return window.AppTranslations?.translate ? window.AppTranslations.translate(text) : text;
    };

    const showToast = (message, type = "success", options = {}) => {
      const normalizedType = normalizeType(type);
      const cleanMessage = translateFeedback(message || defaultMessages[normalizedType]).trim();
      if (!cleanMessage) return;

      const container = createToastContainer();
      const toast = document.createElement("div");
      toast.className = `${typeClasses[normalizedType]} pointer-events-auto rounded-lg px-4 py-3 text-white shadow-lg transition duration-200`;
      toast.setAttribute("role", normalizedType === "error" ? "alert" : "status");
      toast.innerHTML = `
        <div class="flex items-start gap-3">
          <i class="${icons[normalizedType]} mt-0.5" aria-hidden="true"></i>
          <p class="min-w-0 flex-1 text-sm leading-5"></p>
          <button type="button" class="ml-2 text-white/80 hover:text-white" aria-label="Fermer">
            <i class="fas fa-times" aria-hidden="true"></i>
          </button>
        </div>
      `;
      toast.querySelector("p").textContent = cleanMessage;

      const close = () => {
        toast.classList.add("opacity-0", "translate-y-1");
        setTimeout(() => toast.remove(), 200);
      };

      toast.querySelector("button").addEventListener("click", close);
      container.appendChild(toast);
      setTimeout(close, options.duration || (normalizedType === "error" ? 6500 : 3500));
    };

    const shouldInspectFetch = (input, init = {}) => {
      const method = String(init.method || (input?.method || "GET")).toUpperCase();
      return method !== "GET";
    };

    const installFetchFeedback = () => {
      if (!window.fetch || window.fetch.__feedbackInstalled) return;
      const originalFetch = window.fetch.bind(window);

      const wrappedFetch = async (input, init = {}) => {
        let response;
        try {
          response = await originalFetch(input, init);
        } catch (error) {
          showToast(
            error?.message || "Connexion impossible. Vérifiez votre réseau puis réessayez.",
            "error"
          );
          throw error;
        }

        if (!shouldInspectFetch(input, init)) return response;

        const contentType = response.headers.get("content-type") || "";
        if (contentType.includes("application/json")) {
          response.clone().json().then((payload) => {
            if (payload?.success === false || !response.ok) {
              showToast(getMessageFromPayload(payload, defaultMessages.error), "error");
              return;
            }
            if (payload?.success === true && payload?.message) {
              showToast(payload.message, "success");
            }
          }).catch(() => {
            if (!response.ok) showToast(defaultMessages.error, "error");
          });
        } else if (!response.ok) {
          showToast(defaultMessages.error, "error");
        }

        return response;
      };

      wrappedFetch.__feedbackInstalled = true;
      window.fetch = wrappedFetch;
    };

    const installAlertFeedback = () => {
      if (window.alert.__feedbackInstalled) return;
      const nativeAlert = window.alert.bind(window);

      const toastAlert = (message) => {
        const text = String(message || "").trim();
        const type = /erreur|impossible|invalide|obligatoire|veuillez|échec|echec|refus/i.test(text)
          ? "error"
          : "success";
        showToast(text || defaultMessages[type], type);
      };

      toastAlert.native = nativeAlert;
      toastAlert.__feedbackInstalled = true;
      window.alert = toastAlert;
    };

    const installFormFeedback = () => {
      document.addEventListener("invalid", (event) => {
        const field = event.target;
        const label = field.id
          ? document.querySelector(`label[for="${CSS.escape(field.id)}"]`)?.textContent
          : "";
        const fieldName = (label || field.getAttribute("aria-label") || field.name || "ce champ").trim();
        const message = field.validationMessage || `Veuillez vérifier ${fieldName}.`;
        showToast(`${fieldName}: ${message}`, "error");
      }, true);

      document.addEventListener("submit", (event) => {
        const form = event.target;
        if (!(form instanceof HTMLFormElement)) return;
        if (!form.checkValidity()) {
          showToast("Le formulaire contient des champs invalides ou incomplets.", "error");
          return;
        }
        const method = String(form.method || "GET").toUpperCase();
        if (method !== "GET" && !form.dataset.noSubmitToast) {
          showToast("Traitement en cours...", "info", { duration: 1800 });
        }
      }, true);
    };

    const showFlashMessages = () => {
      const flash = document.getElementById("app-flash-messages");
      if (!flash) return;
      const success = flash.dataset.success?.trim();
      const error = flash.dataset.error?.trim();
      if (error) showToast(error, "error");
      if (success) showToast(success, "success");
    };

    window.AppFeedback = {
      show: showToast,
      success: (message) => showToast(message, "success"),
      error: (message) => showToast(message, "error"),
      warning: (message) => showToast(message, "warning"),
      info: (message) => showToast(message, "info"),
      messageFromPayload: getMessageFromPayload
    };

    window.showToastFn = showToast;
    window.addEventListener("show-toast", (event) => {
      showToast(event.detail?.message, event.detail?.type || "success");
    });

    installFetchFeedback();
    installAlertFeedback();

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => {
        installFormFeedback();
        showFlashMessages();
      }, { once: true });
    } else {
      installFormFeedback();
      showFlashMessages();
    }
  })();
  // Gestion du chargement

  window.showLoading = () => {
    Alpine.store("loading").loading = true;
  };

  window.hideLoading = () => {
    Alpine.store("loading").loading = false;
  }
  // Confirmation avant action
  ;

  window.confirmAction = (message, callback) => {
    if (confirm(message || "Êtes-vous sûr de vouloir effectuer cette action ?")) {
      callback();
    }
  }
  // Debounce pour les recherches
  ;

  function debounce(func, wait) {
    let timeout;
    return function executedFunction(...args) {
      const later = () => {
        clearTimeout(timeout);
        func(...args);
      };
      clearTimeout(timeout);
      timeout = setTimeout(later, wait);
    };
  }
  // Export des fonctions globales

  window.formatDate = formatDate;

  window.formatDateTime = formatDateTime;

  window.formatCurrency = formatCurrency;

  window.formatPercentage = formatPercentage;

  window.truncateText = truncateText;

  window.debounce = debounce;
</script>
