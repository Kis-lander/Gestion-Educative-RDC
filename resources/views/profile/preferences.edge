  @section('content')
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Apparence -->
      <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6">
        <h3 class="font-semibold text-lg border-b pb-2 mb-4">
          Apparence
        </h3>

        <form
          method="POST"
          action="/profile/preferences"
          x-data="{ loading: false, selectedTheme: '{{ preferences.theme || 'dark' }}', selectedLanguage: '{{ preferences.language || 'fr' }}' }"
          x-init="
            const storedDarkMode = localStorage.getItem('darkMode');
            if (storedDarkMode !== null) {
              selectedTheme = storedDarkMode === 'true' ? 'dark' : 'light';
            }
            const storedLanguage = localStorage.getItem('appLanguage');
            if (storedLanguage) {
              selectedLanguage = storedLanguage;
            }
            $watch('darkMode', value => {
              selectedTheme = value ? 'dark' : 'light';
            });
            window.addEventListener('app-language-change', event => {
              if (event.detail?.language) {
                selectedLanguage = event.detail.language;
              }
            });
          "
          @submit="
            const language = selectedLanguage || $el.querySelector('[name=language]')?.value || 'fr';
            const themeValue = $el.querySelector('[name=theme]:checked')?.value || 'dark';
            localStorage.setItem('appLanguage', language);
            localStorage.setItem('appLanguageExplicit', 'true');
            window.AppTranslations?.setLanguage(language);
            localStorage.setItem('darkMode', themeValue === 'dark' ? 'true' : 'false');
            darkMode = themeValue === 'dark';
            document.documentElement.classList.toggle('dark', themeValue === 'dark');
            loading = true;
          "
        >
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

          <div class="space-y-4">
            <div>
              <label class="block text-gray-700 dark:text-gray-300 mb-2">Thème</label>
              <div class="grid grid-cols-2 gap-3">
                <label
                  class="flex items-center justify-center gap-2 p-3 border rounded-lg cursor-pointer hover:bg-gray-50"
                  :class="selectedTheme === 'light' ? 'border-primary bg-blue-50 dark:bg-blue-900/20' : ''"
                >
                  <input
                    type="radio"
                    name="theme"
                    value="light"
                    class="w-4 h-4"
                    x-model="selectedTheme"
                    @change="selectedTheme = 'light'"
                    {{ preferences.theme === 'light' ? 'checked' : '' }}
                  />
                  <i class="fas fa-sun text-yellow-500"></i>
                  <span>Clair</span>
                </label>
                <label
                  class="flex items-center justify-center gap-2 p-3 border rounded-lg cursor-pointer hover:bg-gray-50"
                  :class="selectedTheme === 'dark' ? 'border-primary bg-blue-50 dark:bg-blue-900/20' : ''"
                >
                  <input
                    type="radio"
                    name="theme"
                    value="dark"
                    class="w-4 h-4"
                    x-model="selectedTheme"
                    @change="selectedTheme = 'dark'"
                    {{ preferences.theme === 'dark' ? 'checked' : '' }}
                  />
                  <i class="fas fa-moon text-blue-500"></i>
                  <span>Sombre</span>
                </label>
              </div>
            </div>

            <div>
              <label class="block text-gray-700 dark:text-gray-300 mb-2">Langue</label>
              <select name="language" x-model="selectedLanguage" class="w-full px-3 py-2 border rounded-lg">
                <option value="fr" {{ preferences.language === 'fr' ? 'selected' : '' }}>
                  Français
                </option>
                <option value="en" {{ preferences.language === 'en' ? 'selected' : '' }}>
                  English
                </option>
                <option value="ln" {{ preferences.language === 'ln' ? 'selected' : '' }}>
                  Lingala
                </option>
                <option value="sw" {{ preferences.language === 'sw' ? 'selected' : '' }}>
                  Swahili
                </option>
                <option value="kg" {{ preferences.language === 'kg' ? 'selected' : '' }}>
                  Kikongo
                </option>
                <option value="lua" {{ preferences.language === 'lua' ? 'selected' : '' }}>
                  Tshiluba
                </option>
              </select>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t">
            <button
              type="submit"
              :disabled="loading"
              class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-blue-700"
            >
              <i x-show="loading" class="fas fa-spinner fa-spin mr-2"></i>
              Enregistrer
        </button>
          </div>
        </form>
      </div>

      <!-- Notifications -->
      <div class="bg-white dark:bg-gray-800 rounded-xl shadow-md p-6">
        <h3 class="font-semibold text-lg border-b pb-2 mb-4">
          Notifications
        </h3>

        <form
          method="POST"
          action="/profile/notifications-prefs"
          x-data="{ loading: false }"
          @submit="loading = true"
        >
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />

          <div class="space-y-3">
            <label class="flex items-center justify-between cursor-pointer">
              <div>
                <span class="font-medium">Messages</span>
                <p class="text-xs text-gray-500">
                  Notifications pour les nouveaux messages
                </p>
              </div>
              <input
                type="checkbox"
                name="notify_messages"
                value="1"
                class="w-5 h-5"
                {{ preferences.notifyMessages ? 'checked' : '' }}
              />
            </label>

            <label class="flex items-center justify-between cursor-pointer">
              <div>
                <span class="font-medium">Notes et résultats</span>
                <p class="text-xs text-gray-500">
                  Nouvelles notes, bulletins
                </p>
              </div>
              <input
                type="checkbox"
                name="notify_grades"
                value="1"
                class="w-5 h-5"
                {{ preferences.notifyGrades ? 'checked' : '' }}
              />
            </label>

            <label class="flex items-center justify-between cursor-pointer">
              <div>
                <span class="font-medium">Discipline</span>
                <p class="text-xs text-gray-500">
                  Incidents, sanctions
                </p>
              </div>
              <input
                type="checkbox"
                name="notify_discipline"
                value="1"
                class="w-5 h-5"
                {{ preferences.notifyDiscipline ? 'checked' : '' }}
              />
            </label>

            <label class="flex items-center justify-between cursor-pointer">
              <div>
                <span class="font-medium">Paiements</span>
                <p class="text-xs text-gray-500">
                  Échéances, reçus
                </p>
              </div>
              <input
                type="checkbox"
                name="notify_payments"
                value="1"
                class="w-5 h-5"
                {{ preferences.notifyPayments ? 'checked' : '' }}
              />
            </label>

            <label class="flex items-center justify-between cursor-pointer">
              <div>
                <span class="font-medium">Événements</span>
                <p class="text-xs text-gray-500">
                  Événements scolaires, réunions
                </p>
              </div>
              <input
                type="checkbox"
                name="notify_events"
                value="1"
                class="w-5 h-5"
                {{ preferences.notifyEvents ? 'checked' : '' }}
              />
            </label>
          </div>

          <div class="mt-6 pt-4 border-t">
            <button
              type="submit"
              :disabled="loading"
              class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-blue-700"
            >
              <i x-show="loading" class="fas fa-spinner fa-spin mr-2"></i>
              Enregistrer
        </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Préférences avancées -->
    <div class="mt-6 bg-white dark:bg-gray-800 rounded-xl shadow-md p-6">
      <h3 class="font-semibold text-lg border-b pb-2 mb-4">
        Préférences avancées
      </h3>

      <div class="space-y-4">
        <label class="flex items-center justify-between cursor-pointer">
          <div>
            <span class="font-medium">Raccourcis clavier</span>
            <p class="text-xs text-gray-500">
              Activer les raccourcis clavier
            </p>
          </div>
          <input
            type="checkbox"
            name="keyboard_shortcuts"
            class="w-5 h-5"
            {{ preferences.keyboardShortcuts ? 'checked' : '' }}
          />
        </label>

        <label class="flex items-center justify-between cursor-pointer">
          <div>
            <span class="font-medium">Confirmation avant suppression</span>
            <p class="text-xs text-gray-500">
              Demander confirmation avant de supprimer
            </p>
          </div>
          <input
            type="checkbox"
            name="confirm_delete"
            class="w-5 h-5"
            {{ preferences.confirmDelete ? 'checked' : '' }}
          />
        </label>

        <label class="flex items-center justify-between cursor-pointer">
          <div>
            <span class="font-medium">Auto-sauvegarde</span>
            <p class="text-xs text-gray-500">
              Sauvegarder automatiquement les formulaires
            </p>
          </div>
          <input type="checkbox" name="auto_save" class="w-5 h-5" {{ preferences.autoSave ? 'checked' : '' }} />
        </label>
      </div>

      <div class="mt-6 pt-4 border-t">
        <button
          onclick="saveAdvancedPrefs()"
          class="px-6 py-2 bg-primary text-white rounded-lg hover:bg-blue-700"
        >
          Enregistrer
    </button>
      </div>
    </div>

    <script>
      function saveAdvancedPrefs() {
        const translate = (text) => window.AppTranslations?.translate(text) || text;
        const keyboardShortcuts = document.querySelector('input[name="keyboard_shortcuts"]').checked;
        const confirmDelete = document.querySelector('input[name="confirm_delete"]').checked;
        const autoSave = document.querySelector('input[name="auto_save"]').checked;
        fetch("/api/profile/advanced-preferences", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            "X-CSRF-TOKEN": "{{ csrfToken }}"
          },
          body: JSON.stringify({
            keyboardShortcuts: keyboardShortcuts,
            confirmDelete: confirmDelete,
            autoSave: autoSave
          })
        }).then(res => res.json()).then(data => {
          if (data.success) alert(translate("Préférences enregistrées")); else alert(`${translate("Erreur:")} ${data.message}`);
        });
      }
    </script>
  @endsection
  
